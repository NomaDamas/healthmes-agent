# HealthMes Agent environment (cp .env.example .env).
#
# Two consumers:
#   1. healthmes/config.py reads every HEALTHMES_* variable (env prefix).
#   2. docker-compose.yml interpolates the un-prefixed variables below.
# Defaults here (and in healthmes/config.py) target mac-native localhost
# development; inside containers docker-compose.yml overrides the in-cluster
# endpoints (database/ow/hermes URLs), so this file never needs docker
# service hostnames.

# ─── healthmes service (HEALTHMES_ prefix) ──────────────────────────────────
# SQLAlchemy URL of the dedicated healthmes database. Default: zero-setup
# repo-local sqlite. For the postgres-backed native run (after `make
# mac-setup` + `make mac-services-start`) uncomment the second line.
HEALTHMES_DATABASE_URL=sqlite:///./data/healthmes.db
#HEALTHMES_DATABASE_URL=postgresql+psycopg://healthmes:healthmes@localhost:5432/healthmes
# (docker compose sets: postgresql+psycopg://healthmes:healthmes@postgres:5432/healthmes)

# open-wearables backend REST API (read-only consumer).
HEALTHMES_OW_BASE_URL=http://localhost:8000
# (docker compose sets: http://ow-backend:8000)

# API key issued in the open-wearables developer portal (same key the vendor
# MCP server uses).
HEALTHMES_OW_API_KEY=

# UUID of the single open-wearables user this deployment reads. Optional:
# when empty, tools auto-discover via GET /api/v1/users (works only when the
# API key sees exactly one user).
HEALTHMES_OW_USER_ID=

# HealthMes Decision Agent runtime. scripts/bootstrap.py renders a dedicated,
# filtered Hermes profile, owner-only attestation key, and content-bound
# manifest under $HERMES_HOME/decision. The HealthMes-owned supervisor starts
# that exact profile and exposes only the bounded Responses/session surface.
# HealthMes verifies a fresh nonce-HMAC attestation immediately before one
# authenticated POST /v1/responses autonomous turn.
#HEALTHMES_DECISION_HERMES_BASE_URL=http://127.0.0.1:8645
#HEALTHMES_DECISION_HERMES_MODEL=<provider-model-id>
#HEALTHMES_DECISION_HERMES_PROVIDER=openai
#OPENAI_API_KEY=
# Optional per-decision route overrides for custom/OpenAI-compatible models.
#HEALTHMES_DECISION_HERMES_MODEL_BASE_URL=
#HEALTHMES_DECISION_HERMES_MODEL_API_KEY=
#HEALTHMES_DECISION_HERMES_PROFILE_PATH=~/.hermes/decision/config.yaml
#HEALTHMES_DECISION_HERMES_RUNTIME_MANIFEST_PATH=~/.hermes/decision/runtime-manifest.json
#HEALTHMES_DECISION_HERMES_ATTESTATION_KEY_PATH=~/.hermes/decision/runtime-attestation.key
#HEALTHMES_DECISION_HERMES_API_KEY=
# Stable request-correlation secret. Bootstrap generates it independently;
# do not rotate it when rotating the Hermes API credential.
#HEALTHMES_DECISION_CORRELATION_SECRET=
# Only canonical private/container service names may use attested HTTP.
# Public remote origins still require HTTPS.
HEALTHMES_DECISION_HERMES_ALLOW_ATTESTED_PRIVATE_HTTP=false
HEALTHMES_DECISION_HERMES_DISCOVERY_TIMEOUT_SECONDS=5
HEALTHMES_DECISION_HERMES_MAX_ITERATION_TIMEOUT_SECONDS=120
HEALTHMES_DECISION_TIMEOUT_SECONDS=60
# The supervisor combines the overall decision timeout above with these
# bounded child TERM/KILL windows. After owned serving is ready, it publishes
# the exact budget bound to the launcher PID/start token/service nonce and
# gives Uvicorn the same finite graceful-shutdown timeout.
HEALTHMES_DECISION_RUNTIME_CHILD_TERM_TIMEOUT_SECONDS=10
HEALTHMES_DECISION_RUNTIME_CHILD_KILL_TIMEOUT_SECONDS=5
HEALTHMES_DECISION_HERMES_SESSION_TTL_SECONDS=900
HEALTHMES_DECISION_HERMES_SESSION_PURGE_INTERVAL_SECONDS=60
# Bounds atomic source revalidation and DecisionRecord persistence after the
# model turn. Before commit begins, timeout fails closed and prevents late
# writes. Once commit begins, timeout returns an unknown outcome that callers
# recover by request_id instead of guessing whether persistence succeeded.
HEALTHMES_DECISION_FINALIZATION_TIMEOUT_SECONDS=5
# local requires a loopback Hermes origin. Select hosted explicitly whenever
# prompts or aggregate context can leave this machine, including a loopback
# Hermes process that proxies a cloud model.
HEALTHMES_DECISION_EXECUTION_SCOPE=local
# Counts both the running request and accepted queued requests. Excess work
# fails fast with HTTP 429 instead of waiting behind the Hermes model loop.
HEALTHMES_DECISION_MAX_PENDING_REQUESTS=8
HEALTHMES_DECISION_OWNER_PRINCIPAL_ID=owner

# Externally reachable base URL of the healthmes service — used to build
# decision-viewer links for retained alerts and companion surfaces. Keep it
# host-reachable (your phone's browser opens it), not a docker service name.
HEALTHMES_PUBLIC_BASE_URL=http://localhost:8100

# Local-first data directory (media files, sqlite db, exports, pidfiles).
HEALTHMES_DATA_DIR=./data
# (docker compose sets: /data — a named volume)

# Local-first food/drink photo extraction. Remote providers are used only when
# selected here, configured with a key, and the analyze request explicitly opts
# in with allow_remote_vision=true. Remote endpoints must use HTTPS.
HEALTHMES_NUTRITION_VISION_PROVIDER=ollama
HEALTHMES_NUTRITION_OLLAMA_BASE_URL=http://127.0.0.1:11434
HEALTHMES_NUTRITION_VISION_MODEL=qwen3-vl:4b-instruct
# Optional immutable digest recorded with each observation.
#HEALTHMES_NUTRITION_VISION_MODEL_DIGEST=sha256:...
HEALTHMES_NUTRITION_VISION_TIMEOUT_SECONDS=120

# Local voice transcription for nutrition captures. Run the open-source
# whisper.cpp server on loopback; HealthMes refuses non-loopback endpoints.
HEALTHMES_NUTRITION_WHISPER_BASE_URL=http://127.0.0.1:8080
HEALTHMES_NUTRITION_TRANSCRIPTION_TIMEOUT_SECONDS=120
HEALTHMES_NUTRITION_TRANSCRIPTION_LANGUAGE=auto

# Optional remote providers. Configure only the selected provider's key.
HEALTHMES_NUTRITION_OPENAI_BASE_URL=https://api.openai.com
HEALTHMES_NUTRITION_OPENAI_API_KEY=
HEALTHMES_NUTRITION_OPENAI_MODEL=gpt-5.6-sol
HEALTHMES_NUTRITION_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HEALTHMES_NUTRITION_GEMINI_API_KEY=
HEALTHMES_NUTRITION_GEMINI_MODEL=gemini-3.6-flash
HEALTHMES_NUTRITION_ANTHROPIC_BASE_URL=https://api.anthropic.com
HEALTHMES_NUTRITION_ANTHROPIC_API_KEY=
HEALTHMES_NUTRITION_ANTHROPIC_MODEL=claude-fable-5
HEALTHMES_NUTRITION_XAI_BASE_URL=https://api.x.ai
HEALTHMES_NUTRITION_XAI_API_KEY=
HEALTHMES_NUTRITION_XAI_MODEL=grok-4.5

# Service port.
HEALTHMES_PORT=8100

# Interface the service binds. The localhost default keeps the surface
# (medical records, health context, /mcp) off the network. Set 0.0.0.0 to
# accept LAN clients (the Android usage collector) — the service then refuses
# to start unless HEALTHMES_API_TOKEN is set. docker compose always runs with
# 0.0.0.0 inside the container, so the token is REQUIRED for compose.
HEALTHMES_HOST=127.0.0.1

# Bearer token protecting the whole HTTP surface (REST + /mcp). Every client
# sends 'Authorization: Bearer <token>' (the Android collector's token field,
# Hermes' healthmes MCP registration, curl). Decision-viewer links embed a
# derived read-only token automatically. Generate one with e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTHMES_API_TOKEN=

# Dedicated signing secret for one-time calendar adjustment confirmations.
# scripts/bootstrap.py generates and persists a 256-bit value when missing.
HEALTHMES_CALENDAR_ADJUSTMENT_SECRET=

# Exact Telegram owner binding for calendar mutation confirmations. Both are
# required; empty or "*" fails closed. In a private chat the chat id usually
# equals the numeric user id.
HEALTHMES_TELEGRAM_OWNER_USER_ID=
HEALTHMES_TELEGRAM_OWNER_CHAT_ID=

# Enable in-process APScheduler loops (10-min trigger sweep, hourly
# cognitive-energy persist, weekly backup, and enabled provider collectors).
HEALTHMES_SCHEDULER_ENABLED=false

# Optional desktop ActivityWatch collector. Both scheduler and this collector
# must be enabled. ActivityWatch stays loopback-only; choose a unique device id
# per computer. WINDOW_MINUTES applies only before the first persisted cursor,
# then imports resume incrementally with the adapter's overlap/stale fence.
HEALTHMES_ACTIVITYWATCH_ENABLED=false
HEALTHMES_ACTIVITYWATCH_INTERVAL_MINUTES=5
HEALTHMES_ACTIVITYWATCH_DEVICE_ID=activitywatch-desktop
HEALTHMES_ACTIVITYWATCH_PLATFORM=macos
#HEALTHMES_ACTIVITYWATCH_TIMEZONE=Asia/Seoul
HEALTHMES_ACTIVITYWATCH_BASE_URL=http://127.0.0.1:5600
HEALTHMES_ACTIVITYWATCH_WINDOW_MINUTES=1440
HEALTHMES_ACTIVITYWATCH_TIMEOUT_SECONDS=15
#HEALTHMES_ACTIVITYWATCH_WINDOW_BUCKET_ID=
#HEALTHMES_ACTIVITYWATCH_AFK_BUCKET_ID=

# Deliver proactive alerts to the native companion apps (iOS/Android), which
# poll /v1/alerts + /v1/briefing/glance — the phone (and mirrored watch) get
# alerts without requiring a messaging channel. Disable only when another
# bounded delivery adapter owns display. Alert hygiene (quiet hours /
# cooldown / daily budget / dedup) applies either way.
#HEALTHMES_NATIVE_ALERT_DELIVERY=true

# IANA timezone of the user (e.g. Asia/Seoul) — local-day boundaries and the
# calendar/app-usage joins in the MCP tools use it. Leave unset on mac-native
# (machine timezone wins); set it when running in docker, where container
# clocks are UTC (docker-compose.yml forwards it to the healthmes service).
#HEALTHMES_TIMEZONE=Asia/Seoul

# Alert hygiene (docs/PLAN.md §11): do-not-disturb window, per-day push
# budget, and per-rule cooldown enforced before proactive decision dispatch.
HEALTHMES_QUIET_HOURS_START=22:30
HEALTHMES_QUIET_HOURS_END=07:00
HEALTHMES_ALERT_DAILY_BUDGET=8
HEALTHMES_ALERT_COOLDOWN_MINUTES=60

# Calendar mirror backends (docs/PLAN.md §6) — the low-friction path is
# `uv run healthmes connect google` / `... connect icloud --username <id>`
# (docs/DEVELOPMENT.md "캘린더 연결"): a successful connect stores the
# token/creds under {HEALTHMES_DATA_DIR} and the sync jobs pick it up
# automatically — none of the flags below need to change. The env settings
# keep working and override the stored creds file.
# Google: put the OAuth client secret at {HEALTHMES_DATA_DIR}/google/
# client_secret.json (one-time Google Cloud step), then `healthmes connect
# google` mints {HEALTHMES_DATA_DIR}/google/calendar_token.json.
HEALTHMES_GOOGLE_CALENDAR_ENABLED=false
HEALTHMES_GOOGLE_CALENDAR_ID=primary
HEALTHMES_GOOGLE_POLL_MINUTES=5
# Optional: where `healthmes connect google` finds the downloaded OAuth
# client JSON when it is not at the standard data-dir path above.
#HEALTHMES_GOOGLE_CLIENT_SECRET_FILE=
# iCloud CalDAV: username = Apple ID email, password = app-specific password
# minted at https://appleid.apple.com (never the account password).
HEALTHMES_CALDAV_ENABLED=false
HEALTHMES_CALDAV_URL=https://caldav.icloud.com
HEALTHMES_CALDAV_USERNAME=
HEALTHMES_CALDAV_APP_PASSWORD=
#HEALTHMES_CALDAV_CALENDAR_NAME=
HEALTHMES_CALDAV_POLL_MINUTES=10

# Local-first encrypted backups (docs/BACKUP.md; `healthmes backup create/
# list/restore` + the weekly scheduler job). Snapshots are age-encrypted with
# this passphrase — without it, `backup create` errors and the weekly job
# skips with a warning. LOSING THE PASSPHRASE MEANS LOSING THE BACKUPS.
HEALTHMES_BACKUP_PASSPHRASE=
# Snapshot directory (default: {HEALTHMES_DATA_DIR}/backups).
#HEALTHMES_BACKUP_DIR=./data/backups
# Direct postgres URL of the open-wearables DB — only needed to include its
# pg_dump in snapshots (the REST URL above cannot produce a dump).
#HEALTHMES_OW_DATABASE_URL=postgresql://open-wearables:open-wearables@localhost:5432/open-wearables
# Hermes state (memory, cron jobs) is included when HEALTHMES_HERMES_HOME is
# set — or via the vendor's own HERMES_HOME env var (native default ~/.hermes,
# compose ./data/hermes).
#HEALTHMES_HERMES_HOME=

# Remote vault replication (docs/BACKUP.md §3): mirror the age-encrypted
# snapshot envelopes to any S3-compatible bucket (AWS S3 / Cloudflare R2 /
# MinIO). The vault only ever sees ciphertext — snapshots are encrypted
# client-side before upload, and the provider refuses to upload anything
# that is not an age envelope. Selector: 'local' (default) or 'remote_vault'
# (keeps the local snapshot AND replicates; the weekly job follows it too).
# Per-command override: `healthmes backup create --provider remote`.
#HEALTHMES_BACKUP_PROVIDER=remote_vault
# Endpoint URL for R2/MinIO; leave unset for AWS S3 proper.
#HEALTHMES_VAULT_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#HEALTHMES_VAULT_BUCKET=my-healthmes-vault
#HEALTHMES_VAULT_ACCESS_KEY_ID=
#HEALTHMES_VAULT_SECRET_ACCESS_KEY=
# Region: 'auto' for R2, a real region for AWS/MinIO.
#HEALTHMES_VAULT_REGION=auto
# Key prefix inside the bucket (default: healthmes-vault).
#HEALTHMES_VAULT_PREFIX=healthmes-vault

# ─── docker compose interpolation ───────────────────────────────────────────
# Host port mappings (defaults shown; HEALTHMES_PORT above is reused for the
# healthmes service mapping).
#DB_PORT=5432
#REDIS_PORT=6379
#API_PORT=8000

# Hermes gateway (vendor/hermes-agent/.env.example has the full catalog).
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# LLM selection (optional — omit both to use the vendor default: Anthropic
# Claude). Any plugin under vendor/hermes-agent/plugins/model-providers/
# works: anthropic, openai-codex, gemini, openrouter, ollama-cloud, bedrock,
# vertex, deepseek, xai, … Set the matching provider's API key env var
# (e.g. OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY) alongside.
# Rendered into the config's root `model:` section by bootstrap; the same
# selection drives both the gateway and `hermes chat`.
#HERMES_MODEL=
#HERMES_PROVIDER=
# For OpenAI-compatible endpoints (OpenAI itself, Ollama, vLLM) via the
# `custom` provider: set the base URL and the key below.
#   OpenAI:  HERMES_PROVIDER=custom  HERMES_MODEL=gpt-5.4
#            HERMES_MODEL_BASE_URL=https://api.openai.com/v1
#            HERMES_MODEL_API_KEY=sk-...
#   Grok:    HERMES_PROVIDER=xai     HERMES_MODEL=grok-4        + XAI_API_KEY
#   Gemini:  HERMES_PROVIDER=gemini  HERMES_MODEL=gemini-3-pro  + GEMINI_API_KEY
#HERMES_MODEL_BASE_URL=
#HERMES_MODEL_API_KEY=
# Host uid/gid owning ./data/hermes (defaults to 10000; set to $(id -u)/$(id -g)).
#HERMES_UID=
#HERMES_GID=

# ─── scripts/bootstrap.py (isolated decision config render) ────────────────
# The decision profile has no Telegram, webhook, cron, or direct channel
# configuration. Future channel implementations must call the UI-neutral
# HealthMes decision adapter instead of invoking Hermes directly.
