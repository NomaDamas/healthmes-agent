[Unit]
Description=HealthMes personal self-host stack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPO_ROOT__
ExecStartPre=__LINUX_SCRIPT__ wait-for-docker
ExecStart=__DOCKER__ compose -f docker-compose.yml -f docker-compose.linux.yml up -d --build
ExecStop=__DOCKER__ compose -f docker-compose.yml -f docker-compose.linux.yml down
TimeoutStartSec=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
