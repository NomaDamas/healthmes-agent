# Public ingress for the local-first owner instance. The credential itself
# stays in ~/.cloudflared and is intentionally not committed.
tunnel: 62003c8c-a4a3-44d1-81fc-4d4118ef7271
credentials-file: __HOME__/.cloudflared/62003c8c-a4a3-44d1-81fc-4d4118ef7271.json
ingress:
  - hostname: healthmes-agent.jinminseong.com
    service: http://127.0.0.1:__HEALTHMES_PORT__
  - hostname: healthmes.jinminseong.com
    service: http://127.0.0.1:__HEALTHMES_PORT__
  - service: http_status:404
