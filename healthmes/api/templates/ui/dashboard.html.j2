{% extends "ui/_base.html.j2" %}

{% block title %}Wellness Control — HealthMes{% endblock %}
{% block crumb %}<span class="crumb">/ Wellness</span>{% endblock %}

{% block head %}
<style>
  header.site nav.site-nav { display: none; }
  header.site .ambience { margin-left: auto; }
  main { max-width: 76rem; padding-bottom: 8.5rem; }
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .wellness-shell {
    --google: #4285f4;
    --apple: #14947d;
    --healthmes: #d8822a;
    --capacity: var(--brand);
    --metadata-ink: var(--ink-2);
    display: grid;
    gap: 0.9rem;
  }
  .capacity-copy p {
    display: none !important;
  }
  .wellness-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0.15rem 0;
  }
  .wellness-header h1 {
    margin: 0.18rem 0 0;
    max-width: 46rem;
    font-size: clamp(1.45rem, 4vw, 2rem);
    line-height: 1.35;
  }
  .header-state {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .state-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 2rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: var(--glass-solid);
    color: var(--ink-2);
    font-size: 0.74rem;
    font-weight: 760;
    white-space: nowrap;
  }
  .state-chip::before {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--brand);
    content: "";
  }
  .state-chip.read-only::before { background: #b1721e; }

  .control-frame {
    overflow: hidden;
    border: 1px solid var(--glass-line);
    border-radius: 25px;
    background:
      radial-gradient(circle at 88% 0%, var(--brand-soft), transparent 32%),
      var(--glass);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    backdrop-filter: blur(20px) saturate(150%);
    box-shadow: var(--shadow);
  }
  .lens-bar {
    position: sticky;
    top: 4.1rem;
    z-index: 12;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.3rem;
    max-width: 32rem;
    margin: 0 auto;
    padding: 0.8rem 1rem 0.6rem;
  }
  .lens-tab {
    display: grid;
    gap: 0.04rem;
    min-width: 0;
    padding: 0.5rem 0.72rem;
    border: 1px solid transparent;
    border-radius: 13px;
    color: var(--ink-2);
    text-align: center;
    text-decoration: none;
  }
  .lens-tab strong { font-size: 0.9rem; }
  .lens-tab span { color: var(--metadata-ink); font-size: 0.68rem; }
  .lens-tab:hover {
    border-color: var(--line-soft);
    background: var(--surface-2);
    color: var(--ink);
    text-decoration: none;
  }
  .lens-tab[aria-selected="true"] {
    border-color: var(--glass-line);
    background: var(--glass-solid);
    color: var(--ink);
    box-shadow: 0 6px 20px rgba(17, 38, 30, 0.08);
  }
  .lens-tab[aria-selected="true"] span { color: var(--brand-deep); }

  .scene-panel {
    display: grid;
    gap: 0.85rem;
    padding: 0.85rem clamp(0.7rem, 2.8vw, 1.3rem) 1.3rem;
    scroll-margin-top: 8rem;
  }
  .wellness-shell[data-enhanced="true"] .scene-panel:not([data-active="true"]) {
    display: none;
  }
  .primitive {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--glass-line);
    border-radius: 19px;
    background: color-mix(in srgb, var(--glass-solid) 86%, transparent);
    box-shadow: 0 8px 26px rgba(17, 38, 30, 0.055);
  }
  @supports not (background: color-mix(in srgb, white 50%, transparent)) {
    .primitive { background: var(--glass-solid); }
  }
  .primitive-body { padding: clamp(0.9rem, 2.5vw, 1.15rem); }
  .primitive-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.65rem;
  }
  .primitive-head h2,
  .primitive-head h3 { margin: 0; font-size: 1rem; }
  .primitive-head a { font-size: 0.78rem; font-weight: 760; }
  .primitive-label {
    color: var(--brand-deep);
    font-size: 0.68rem;
    font-weight: 820;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .capacity-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(0.75rem, 2.5vw, 1.2rem);
    align-items: center;
    padding: clamp(0.95rem, 2.6vw, 1.3rem);
  }
  .capacity-score {
    display: grid;
    place-items: center;
    width: 4.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle closest-side, var(--glass-solid) 76%, transparent 78% 99%),
      conic-gradient(
        var(--capacity) calc(var(--capacity-value, 0) * 1%),
        var(--surface-2) 0
      );
    color: var(--brand-deep);
    font-size: 1.22rem;
    font-weight: 840;
    font-variant-numeric: tabular-nums;
  }
  .capacity-score.is-missing {
    border: 1px dashed var(--line-strong);
    background: var(--surface-2);
  }
  .capacity-score span {
    display: block;
    color: var(--metadata-ink);
    font-size: 0.61rem;
    font-weight: 720;
    line-height: 1;
    text-align: center;
  }
  .capacity-copy h2 {
    margin: 0.18rem 0 0.35rem;
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.38;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .capacity-copy p { margin: 0; }
  .capacity-meta {
    display: grid;
    justify-items: end;
    gap: 0.35rem;
    color: var(--ink-2);
    font-size: 0.75rem;
    text-align: right;
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(19rem, 0.75fr);
    gap: 0.85rem;
    align-items: start;
  }
  .calendar-canvas { overflow: hidden; }
  .calendar-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .calendar-title {
    display: grid;
    gap: 0.32rem;
  }
  .calendar-freshness {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    flex-wrap: wrap;
    color: var(--metadata-ink);
    font-size: 0.68rem;
    font-weight: 680;
  }
  .calendar-freshness span {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
  }
  .calendar-freshness span::before {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--capacity);
    content: "";
  }
  .calendar-freshness .unconfirmed::before { background: var(--warning); }
  .calendar-freshness .stale::before,
  .calendar-freshness .future-skew::before { background: var(--danger); }
  .provider-legend {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    color: var(--ink-2);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .provider-key {
    display: inline-flex;
    align-items: center;
    gap: 0.33rem;
  }
  .provider-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--provider-color, var(--ink-3));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--provider-color, var(--ink-3)) 13%, transparent);
  }
  .provider-google { --provider-color: var(--google); }
  .provider-caldav { --provider-color: var(--apple); }
  .provider-healthmes { --provider-color: var(--healthmes); }

  .energy-chart {
    margin: 0 0 0.8rem;
    padding: 0.72rem 0.75rem 0.45rem;
    border: 1px solid var(--line-soft);
    border-radius: 14px;
    background: var(--brand-wash);
  }
  .energy-chart figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.28rem;
  }
  .energy-chart figcaption strong { font-size: 0.8rem; }
  .energy-chart figcaption span { color: var(--metadata-ink); font-size: 0.68rem; }
  .energy-svg {
    display: block;
    width: 100%;
    height: auto;
    min-height: 5rem;
    overflow: visible;
  }
  .energy-grid { stroke: var(--line-soft); stroke-width: 1; }
  .energy-bar { fill: var(--brand); opacity: 0.8; }
  .energy-missing { fill: var(--line-soft); }
  .energy-axis {
    fill: var(--ink-2);
    font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-size: 8px;
  }

  .calendar-timeline {
    position: relative;
    display: grid;
    gap: 0.48rem;
    margin: 0;
    padding: 0 0 0 1.25rem;
    list-style: none;
  }
  .calendar-timeline::before {
    position: absolute;
    top: 0.45rem;
    bottom: 0.45rem;
    left: 0.31rem;
    width: 1px;
    background: var(--line);
    content: "";
  }
  .calendar-event {
    --provider-color: var(--ink-3);
    position: relative;
    display: grid;
    grid-template-columns: minmax(7.7rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
    min-width: 0;
    padding: 0.78rem 0.82rem;
    border: 1px solid var(--line-soft);
    border-left: 4px solid var(--provider-color);
    border-radius: 13px;
    background: var(--surface-2);
  }
  .calendar-event[data-duration-minutes] {
    min-height: clamp(
      3.6rem,
      calc(var(--duration-minutes, 60) * 0.06rem),
      13rem
    );
  }
  .calendar-event[data-gap-minutes] {
    margin-top: clamp(
      0rem,
      calc(var(--gap-minutes, 0) * 0.06rem),
      7rem
    );
  }
  .calendar-event::before {
    position: absolute;
    top: 1.05rem;
    left: -1.52rem;
    width: 0.62rem;
    height: 0.62rem;
    border: 2px solid var(--glass-solid);
    border-radius: 50%;
    background: var(--provider-color);
    box-shadow: 0 0 0 1px var(--provider-color);
    content: "";
  }
  .calendar-event.provider-google { --provider-color: var(--google); }
  .calendar-event.provider-caldav { --provider-color: var(--apple); }
  .event-time {
    color: var(--ink-2);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
  }
  .event-copy { min-width: 0; }
  .event-copy strong {
    display: block;
    line-height: 1.42;
    overflow-wrap: anywhere;
  }
  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
    color: var(--metadata-ink);
    font-size: 0.69rem;
  }
  .provider-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--ink-2);
    font-weight: 790;
  }
  .provider-badge::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--provider-color);
    content: "";
  }
  .proposal-preview-event {
    --provider-color: var(--healthmes);
    border-style: dashed;
    background: color-mix(in srgb, var(--healthmes) 8%, var(--surface-2));
  }

  .decision-remote {
    position: sticky;
    top: 8.3rem;
  }
  .proposal-title {
    margin: 0.38rem 0 0.75rem;
    font-size: clamp(1.15rem, 2.6vw, 1.42rem);
    line-height: 1.42;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .change-preview {
    display: grid;
    gap: 0.5rem;
  }
  .change-state {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
    padding: 0.68rem 0.72rem;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    background: var(--surface-2);
  }
  .change-state.after {
    border-color: color-mix(in srgb, var(--healthmes) 45%, var(--line-soft));
    background: color-mix(in srgb, var(--healthmes) 9%, var(--surface-2));
  }
  .change-state dt {
    color: var(--metadata-ink);
    font-size: 0.68rem;
    font-weight: 780;
  }
  .change-state dd {
    min-width: 0;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 740;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .change-arrow {
    color: var(--healthmes);
    font-size: 1rem;
    font-weight: 840;
    line-height: 1;
    text-align: center;
  }
  .semantic-result {
    display: grid;
    gap: 0.5rem;
    margin: 0.78rem 0 0;
  }
  .semantic-row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0;
    color: var(--ink-2);
    font-size: 0.78rem;
  }
  .semantic-row dt {
    color: var(--brand-deep);
    font-weight: 800;
  }
  .semantic-row dd { margin: 0; overflow-wrap: anywhere; }
  .read-only-action {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.85rem;
    padding: 0.72rem;
    border: 1px solid rgba(177, 114, 30, 0.3);
    border-radius: 12px;
    background: rgba(177, 114, 30, 0.08);
  }
  .read-only-action p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.75rem;
  }
  .read-only-action .btn { justify-self: start; }

  .goal-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    gap: 0.85rem;
  }
  .goal-list {
    display: grid;
    gap: 0.7rem;
  }
  .goal-item {
    padding: 0.78rem;
    border: 1px solid var(--line-soft);
    border-radius: 13px;
    background: var(--surface-2);
  }
  .goal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .goal-top strong { overflow-wrap: anywhere; }
  .goal-top span {
    color: var(--ink-2);
    font-size: 0.73rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .progress-track {
    height: 0.52rem;
    margin-top: 0.58rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line-soft);
  }
  .progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand), color-mix(in srgb, var(--brand) 58%, #d3a52e));
  }
  .weekly-energy {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.34rem;
    align-items: end;
    min-height: 8.5rem;
    padding-top: 0.45rem;
  }
  .week-day {
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 0.25rem;
    min-width: 0;
    height: 8rem;
    text-align: center;
  }
  .week-bar-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 5.5rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .week-bar {
    width: min(1.05rem, 70%);
    min-height: 0.18rem;
    border-radius: 999px 999px 0.2rem 0.2rem;
    background: var(--brand);
    opacity: 0.78;
  }
  .week-bar.missing {
    height: 0.18rem;
    background: var(--line);
  }
  .week-score {
    color: var(--ink-2);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }
  .week-label {
    overflow: hidden;
    color: var(--metadata-ink);
    font-size: 0.62rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .context-grid,
  .history-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .signal-list,
  .decision-list,
  .insight-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .signal-row,
  .decision-list li,
  .insight-item {
    padding: 0.68rem 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .signal-row:last-child,
  .decision-list li:last-child,
  .insight-item:last-child { border-bottom: 0; }
  .signal-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .signal-row strong,
  .decision-list strong,
  .insight-item strong {
    display: block;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .signal-row span,
  .decision-meta,
  .insight-meta {
    color: var(--metadata-ink);
    font-size: 0.72rem;
  }
  .decision-list a { display: block; color: inherit; }
  .decision-list a:hover { text-decoration: none; }
  .decision-meta,
  .insight-meta {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    flex-wrap: wrap;
    margin-top: 0.28rem;
  }
  .outcome-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .outcome-stat {
    padding: 0.82rem;
    border: 1px solid var(--line-soft);
    border-radius: 13px;
    background: var(--surface-2);
  }
  .outcome-stat strong {
    display: block;
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .outcome-stat span { color: var(--ink-2); font-size: 0.7rem; }
  .empty-state {
    margin: 0;
    padding: 0.85rem 0;
    color: var(--ink-2);
  }
  .honesty-note {
    margin-top: 0.65rem;
    padding: 0.68rem 0.76rem;
    border-left: 3px solid var(--brand);
    border-radius: 4px 11px 11px 4px;
    background: var(--brand-wash);
    color: var(--ink-2);
    font-size: 0.76rem;
  }

  details.progressive {
    margin-top: 0.72rem;
    padding-top: 0.64rem;
    border-top: 1px solid var(--line-soft);
  }
  details.progressive summary,
  details.advanced > summary {
    cursor: pointer;
    color: var(--ink-2);
    font-size: 0.8rem;
    font-weight: 760;
  }
  details.advanced {
    padding: 0.9rem 1rem;
    border: 1px solid var(--glass-line);
    border-radius: 16px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .advanced-body {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.8rem;
  }
  .advanced-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.55rem;
  }
  .advanced-links a,
  .advanced-links .advanced-item {
    display: block;
    min-width: 0;
    padding: 0.74rem 0.8rem;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    background: var(--surface-2);
    color: var(--ink);
  }
  .advanced-links a:hover {
    border-color: var(--brand);
    text-decoration: none;
  }
  .connection-list {
    display: flex;
    gap: 0.38rem;
    flex-wrap: wrap;
  }
  .connection-chip {
    display: inline-flex;
    padding: 0.25rem 0.58rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.7rem;
    font-weight: 720;
  }

  .command-dock {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    z-index: 14;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
    width: min(48rem, calc(100% - 1rem));
    padding: 0.55rem;
    border: 1px solid var(--glass-line);
    border-radius: 18px;
    background: var(--glass-solid);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 14px 40px rgba(17, 38, 30, 0.18);
    transform: translateX(-50%);
  }
  .command-voice,
  .command-send {
    display: inline-grid;
    place-items: center;
    min-width: 2.55rem;
    min-height: 2.55rem;
    border: 1px solid var(--line);
    border-radius: 13px;
    background: var(--surface-2);
    color: var(--ink-2);
    font: inherit;
    font-weight: 790;
  }
  .command-send { padding: 0 0.8rem; font-size: 0.76rem; }
  .command-voice:disabled,
  .command-send:disabled { cursor: not-allowed; opacity: 0.72; }
  .command-field { min-width: 0; }
  .command-field label {
    display: block;
    color: var(--metadata-ink);
    font-size: 0.66rem;
    font-weight: 760;
  }
  .command-field input {
    width: 100%;
    padding: 0.14rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.84rem;
    text-overflow: ellipsis;
  }
  .command-note {
    grid-column: 1 / -1;
    margin: -0.08rem 0.2rem 0;
    color: var(--metadata-ink);
    font-size: 0.66rem;
    text-align: center;
  }

  @media (max-width: 880px) {
    .workspace,
    .goal-layout { grid-template-columns: 1fr; }
    .decision-remote { position: static; }
  }
  @media (max-width: 720px) {
    main { padding-inline: 0.7rem; }
    .wellness-header { align-items: flex-start; flex-direction: column; }
    .header-state { justify-content: flex-start; }
    .lens-bar { position: static; }
    .capacity-strip {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .capacity-meta {
      grid-column: 1 / -1;
      grid-auto-flow: column;
      justify-content: start;
      justify-items: start;
      text-align: left;
    }
    .context-grid,
    .history-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 500px) {
    .control-frame { border-radius: 19px; }
    .lens-bar { padding-inline: 0.6rem; }
    .lens-tab { padding-inline: 0.34rem; }
    .lens-tab span { display: none; }
    .scene-panel { padding-inline: 0.58rem; }
    .capacity-score { width: 4rem; }
    .capacity-copy h2 { font-size: 1.12rem; }
    .calendar-event {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .change-state { grid-template-columns: 3.5rem minmax(0, 1fr); }
    .outcome-stats { grid-template-columns: 1fr; }
    .command-dock {
      grid-template-columns: auto minmax(0, 1fr);
      width: calc(100% - 0.35rem);
    }
    .command-send { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lens-tab,
    .command-dock { scroll-behavior: auto; }
  }
</style>
{% endblock %}

{% block content %}
<div class="wellness-shell" data-control-shell data-enhanced="false">
  <header class="wellness-header">
    <div>
      <p class="eyebrow">{{ dashboard.local_today.isoformat() }} · {{ dashboard.timezone }}</p>
      <h1>{{ dashboard.headline }}</h1>
    </div>
    <div class="header-state" aria-label="대시보드 상태">
      <a class="state-chip" href="#advanced">상세 분석</a>
      <span class="state-chip">업데이트 {{ format_rel(dashboard.generated_at) }}</span>
      <span class="state-chip read-only">웹 읽기 전용</span>
    </div>
  </header>

  <div class="control-frame">
    <nav class="lens-bar" role="tablist" aria-label="웰니스 제어 관점" data-lens-tabs>
      <a class="lens-tab"
         id="lens-now"
         role="tab"
         aria-selected="true"
         aria-controls="today"
         data-lens-target="now"
         href="{{ app_path('/dashboard') }}{{ token_qs }}#today">
        <strong>지금</strong>
        <span>몸과 오늘 일정</span>
      </a>
      <a class="lens-tab"
         id="lens-adjust"
         role="tab"
         aria-selected="false"
         aria-controls="plan"
         data-lens-target="adjust"
         href="{{ app_path('/dashboard/plan') }}{{ token_qs }}#plan">
        <strong>조율</strong>
        <span>주간 목표와 계획</span>
      </a>
      <a class="lens-tab"
         id="lens-change"
         role="tab"
         aria-selected="false"
         aria-controls="history"
         data-lens-target="change"
         href="{{ app_path('/dashboard/history') }}{{ token_qs }}#history">
        <strong>변화</strong>
        <span>판단과 결과</span>
      </a>
    </nav>

    <div class="scene-viewport">
      <section class="scene-panel"
               id="today"
               role="tabpanel"
               aria-labelledby="lens-now"
               data-lens-panel="now"
               data-active="true">
        <article class="primitive capacity-strip"
                 data-ui-primitive="capacity_bar"
                 aria-label="현재 인지 에너지">
          <div class="capacity-score{% if dashboard.energy.score is none %} is-missing{% endif %}"
               {% if dashboard.energy.score is not none %}style="--capacity-value: {{ dashboard.energy.score }}"{% endif %}
               role="img"
               aria-label="현재 에너지 {{ dashboard.energy.score if dashboard.energy.score is not none else '측정 중' }}{% if dashboard.energy.score is not none %}점{% endif %}">
            {% if dashboard.energy.score is not none %}
              {{ dashboard.energy.score }}
              <span>/ 100</span>
            {% else %}
              —
              <span>측정 중</span>
            {% endif %}
          </div>
          <div class="capacity-copy">
            <span class="primitive-label">Current capacity</span>
            <h2>{{ dashboard.headline }}</h2>
            <p class="muted">
              현재 에너지와 실제 일정을 함께 비교합니다.
              데이터가 없는 시간은 추정하지 않습니다.
            </p>
          </div>
          <div class="capacity-meta">
            <span>
              데이터 최신성
              {% if dashboard.energy.score is none %}
                없음
              {% elif dashboard.energy.confidence == "high" %}
                현재 시간대
              {% elif dashboard.energy.confidence == "medium" %}
                최대 3시간 전
              {% else %}
                오래됨
              {% endif %}
            </span>
            {% if dashboard.alert_count %}
            <span>확인할 신호 {{ dashboard.alert_count }}개</span>
            {% else %}
            <span>새 경고 없음</span>
            {% endif %}
          </div>
        </article>

        <div class="workspace">
          <article class="primitive primitive-body calendar-canvas"
                   data-ui-primitive="calendar_canvas">
            <div class="calendar-toolbar">
              <div class="calendar-title">
                <span class="primitive-label">Calendar canvas</span>
                <h2 style="margin:0.15rem 0 0;">연결된 캘린더 일정</h2>
                {% if dashboard.calendar_sources %}
                <div class="calendar-freshness" aria-label="캘린더 동기화 상태">
                  {% for source in dashboard.calendar_sources %}
                    {% set observed = dashboard.calendar_sync_observed_at.get(source) %}
                    {% set sync_status = dashboard.calendar_sync_statuses.get(source, 'unconfirmed') %}
                    <span class="{{ sync_status | replace('_', '-') }}">
                      {{ 'Google' if source == 'google' else 'Apple / iCloud' }}
                      {% if sync_status == 'current' %}
                        sync {{ format_rel(observed) }}
                      {% elif sync_status == 'stale' %}
                        sync 오래됨
                      {% elif sync_status == 'future_skew' %}
                        sync 시간 확인 필요
                      {% else %}
                        sync 미확인
                      {% endif %}
                    </span>
                  {% endfor %}
                </div>
                {% endif %}
              </div>
              {% if dashboard.calendar_sources or dashboard.pending_proposals %}
              <div class="provider-legend" aria-label="캘린더 출처 범례">
                {% if "google" in dashboard.calendar_sources %}
                <span class="provider-key provider-google">
                  <span class="provider-dot" aria-hidden="true"></span>Google
                </span>
                {% endif %}
                {% if "caldav" in dashboard.calendar_sources %}
                <span class="provider-key provider-caldav">
                  <span class="provider-dot" aria-hidden="true"></span>Apple / iCloud
                </span>
                {% endif %}
                {% if dashboard.pending_proposals %}
                <span class="provider-key provider-healthmes">
                  <span class="provider-dot" aria-hidden="true"></span>HealthMes 제안
                </span>
                {% endif %}
              </div>
              {% endif %}
            </div>

            {% set known_energy = dashboard.energy.curve_24h
                |selectattr('score', 'ne', none)|list|length %}
            {% if known_energy >= 6 %}
            <figure class="energy-chart" data-ui-primitive="energy_curve">
              <figcaption>
                <strong>오늘의 시간대별 에너지</strong>
                <span>저장된 샘플만 표시</span>
              </figcaption>
              <svg class="energy-svg"
                   viewBox="0 0 400 112"
                   role="img"
                   aria-labelledby="energy-title"
                   aria-describedby="energy-desc energy-values">
                <title id="energy-title">24시간 인지 에너지 막대 그래프</title>
                <desc id="energy-desc">점수가 저장된 시간은 색 막대로, 데이터가 없는 시간은 바닥의 짧은 회색 표시로 나타냅니다.</desc>
                <line class="energy-grid" x1="8" y1="18" x2="392" y2="18"></line>
                <line class="energy-grid" x1="8" y1="57" x2="392" y2="57"></line>
                <line class="energy-grid" x1="8" y1="96" x2="392" y2="96"></line>
                {% for point in dashboard.energy.curve_24h %}
                  {% set x = 10 + (point.hour * 16) %}
                  {% if point.score is not none %}
                    {% set height = point.score * 0.78 %}
                    <rect class="energy-bar"
                          data-energy-hour="{{ point.hour }}"
                          data-energy-score="{{ point.score }}"
                          x="{{ x }}"
                          y="{{ 96 - height }}"
                          width="10"
                          height="{{ height }}"
                          rx="3">
                      <title>{{ "%02d"|format(point.hour) }}시 {{ point.score }}점</title>
                    </rect>
                  {% else %}
                    <rect class="energy-missing"
                          data-energy-hour="{{ point.hour }}"
                          x="{{ x }}"
                          y="94"
                          width="10"
                          height="2"
                          rx="1">
                      <title>{{ "%02d"|format(point.hour) }}시 데이터 없음</title>
                    </rect>
                  {% endif %}
                {% endfor %}
                <text class="energy-axis" x="8" y="108">00</text>
                <text class="energy-axis" x="102" y="108">06</text>
                <text class="energy-axis" x="198" y="108">12</text>
                <text class="energy-axis" x="294" y="108">18</text>
                <text class="energy-axis" x="378" y="108">23</text>
              </svg>
              <ol class="visually-hidden" id="energy-values">
                {% for point in dashboard.energy.curve_24h %}
                <li data-energy-value-hour="{{ point.hour }}">
                  {{ "%02d"|format(point.hour) }}시:
                  {% if point.score is not none %}
                    {{ point.score }}점
                  {% else %}
                    데이터 없음
                  {% endif %}
                </li>
                {% endfor %}
              </ol>
            </figure>
            {% endif %}

            {% if dashboard.plan_events or dashboard.calendar_proposals %}
            {% set calendar_items = (dashboard.plan_events + dashboard.calendar_proposals)
                |sort(attribute='starts_at') %}
            {% set timeline = namespace(latest_end=none) %}
            <ol class="calendar-timeline" aria-label="앞으로 7일 캘린더 일정">
              {% for item in calendar_items %}
              {% set gap_minutes = [((item.starts_at - timeline.latest_end).total_seconds() / 60)|round|int, 0]|max if timeline.latest_end else 0 %}
              {% set duration_minutes = ((item.ends_at - item.starts_at).total_seconds() / 60)|round|int %}
              {% if timeline.latest_end is none or item.ends_at > timeline.latest_end %}
                {% set timeline.latest_end = item.ends_at %}
              {% endif %}
              {% if item.source is defined %}
              <li class="calendar-event provider-{{ item.source }}"
                  data-calendar-provider="{{ item.source }}"
                  data-provider-status="{{ item.status or 'unknown' }}"
                  data-organizer-self="{{ 'true' if item.organizer_self else 'false' }}"
                  data-all-day="{{ 'true' if item.is_all_day else 'false' }}"
                  {% if not item.is_all_day %}
                  data-duration-minutes="{{ duration_minutes }}"
                  {% endif %}
                  data-gap-minutes="{{ gap_minutes }}"
                  style="{% if not item.is_all_day %}--duration-minutes: {{ duration_minutes }}; {% endif %}--gap-minutes: {{ gap_minutes }};">
                <time class="event-time" datetime="{{ item.starts_at.isoformat() }}">
                  {% if item.is_all_day %}
                    종일 일정
                  {% else %}
                    {{ format_local(item.starts_at) }}<br>
                    {{ format_local(item.ends_at) }}
                  {% endif %}
                </time>
                <div class="event-copy">
                  <strong>{{ item.title }}</strong>
                  <div class="event-meta">
                    <span class="provider-badge">
                      {% if item.source == "google" %}
                        Google Calendar
                      {% elif item.source == "caldav" %}
                        Apple / iCloud Calendar
                      {% else %}
                        {{ item.source }}
                      {% endif %}
                    </span>
                    {% if item.is_agent_created %}
                    <span>HealthMes가 관리하는 블록</span>
                    {% else %}
                    <span>외부 일정 · 기본 고정</span>
                    {% endif %}
                    {% if item.is_all_day %}<span>종일</span>{% endif %}
                    {% if item.is_recurring %}<span>반복</span>{% endif %}
                    {% if item.organizer_self %}
                    <span>내가 주최</span>
                    {% elif item.has_attendees %}
                    <span>외부 주최</span>
                    {% endif %}
                    {% if item.is_locked %}<span>잠김</span>{% endif %}
                    {% if item.energy_demand %}
                    <span>요구 에너지 {{ item.energy_demand }}</span>
                    {% endif %}
                    {% if item.status %}<span>상태 {{ item.status }}</span>{% endif %}
                  </div>
                </div>
              </li>
              {% else %}
                <li class="calendar-event proposal-preview-event"
                    data-calendar-provider="healthmes"
                    data-proposal-preview
                    data-proposal-id="{{ item.id }}"
                    data-duration-minutes="{{ duration_minutes }}"
                    data-gap-minutes="{{ gap_minutes }}"
                    style="--duration-minutes: {{ duration_minutes }}; --gap-minutes: {{ gap_minutes }};">
                  <time class="event-time" datetime="{{ item.starts_at.isoformat() }}">
                    {{ format_local(item.starts_at) }}<br>
                    {{ format_local(item.ends_at) }}
                  </time>
                  <div class="event-copy">
                    <strong>{{ item.task_title }} 블록 후보</strong>
                    <div class="event-meta">
                      <span class="provider-badge">HealthMes 제안</span>
                      <span>승인 전 미리보기</span>
                    </div>
                  </div>
                </li>
              {% endif %}
              {% endfor %}
            </ol>
            {% if dashboard.plan_events_truncated %}
            <p class="honesty-note">
              캘린더 {{ dashboard.plan_events_total }}건 중 시간순으로
              {{ dashboard.plan_events|length }}건을 표시합니다.
            </p>
            {% endif %}
            {% if dashboard.calendar_proposals_truncated %}
            <p class="honesty-note">
              변경 제안 {{ dashboard.calendar_proposals_total }}건 중 시간순으로
              {{ dashboard.calendar_proposals|length }}건을 표시합니다.
            </p>
            {% endif %}
            {% else %}
            <p class="empty-state">표시할 Apple 또는 Google Calendar 일정이 없습니다.</p>
            {% endif %}
          </article>

          <aside class="primitive primitive-body decision-remote"
                 data-ui-primitive="proposal_preview"
                 {% if dashboard.pending_proposals %}data-proposal-id="{{ dashboard.pending_proposals[0].id }}"{% endif %}
                 aria-labelledby="pending-change-title">
            <div class="primitive-head">
              <h2 id="pending-change-title">지금 필요한 결정</h2>
              <span class="badge">{{ dashboard.pending_proposals_total }}개 대기</span>
            </div>
            {% if dashboard.pending_proposals %}
              {% set proposal = dashboard.pending_proposals[0] %}
              <span class="primitive-label">Pending proposal</span>
              <p class="proposal-title">{{ proposal.task_title }} 블록을 적용할까요?</p>
              <dl class="change-preview" aria-label="현재 proposal 계약과 제안 블록">
                <div class="change-state before">
                  <dt>현재 계약</dt>
                  <dd>
                    변경 유형과 원본 event identity 미제공
                  </dd>
                </div>
                <div class="change-arrow" aria-hidden="true">↓</div>
                <div class="change-state after">
                  <dt>제안 블록</dt>
                  <dd>
                    {{ format_local(proposal.starts_at) }}<br>
                    {{ format_local(proposal.ends_at) }}
                  </dd>
                </div>
              </dl>
              <dl class="semantic-result">
                <div class="semantic-row">
                  <dt>이유</dt>
                  <dd>{{ proposal.decision_summary or "연결된 판단 기록을 검증하지 못해 이유를 표시하지 않습니다." }}</dd>
                </div>
                <div class="semantic-row">
                  <dt>결과</dt>
                  <dd>승인하면 이 변경안이 연결된 캘린더 쓰기 절차로 전달됩니다. 이 화면은 반영 완료를 미리 주장하지 않습니다.</dd>
                </div>
              </dl>
              {% if proposal.expires_at %}
              <p class="muted">응답 기한 {{ format_local(proposal.expires_at) }}</p>
              {% endif %}
              {% if dashboard.pending_proposals_truncated %}
              <p class="honesty-note">
                총 {{ dashboard.pending_proposals_total }}개 중
                {{ dashboard.pending_proposals|length }}개를 시간순으로 불러왔고,
                현재는 첫 제안을 표시합니다.
              </p>
              {% endif %}
              <div class="read-only-action">
                <p>Yes/No는 iPhone, Mac 또는 Apple Watch에서 실행합니다.</p>
                {% if proposal.decision_url %}
                <a class="btn" href="{{ proposal.decision_url }}">판단 근거 보기</a>
                {% endif %}
              </div>
            {% else %}
              <p class="empty-state">지금 결정할 제안이 없습니다.</p>
              <p class="honesty-note">제안이 없으면 임의의 일정 변경이나 건강 원인을 만들어 표시하지 않습니다.</p>
            {% endif %}
          </aside>
        </div>

        <section class="goal-layout">
          <article class="primitive primitive-body"
                   data-ui-primitive="comparison_bar">
            <div class="primitive-head">
              <h2>이번 주 목표 진행</h2>
              <a href="{{ dashboard.weekly_url }}">주간 리포트</a>
            </div>
            {% if dashboard.goals %}
            <div class="goal-list">
              {% for goal in dashboard.goals %}
              {% set pct = (goal.done_tasks * 100 / goal.total_tasks) if goal.total_tasks else 0 %}
              <div class="goal-item">
                <div class="goal-top">
                  <strong>{{ goal.title }}</strong>
                  <span>{{ goal.done_tasks }}/{{ goal.total_tasks }} 완료</span>
                </div>
                <div class="progress-track"
                     role="progressbar"
                     aria-label="{{ goal.title }} 완료율"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="{{ pct|round|int }}">
                  <span style="width: {{ pct }}%"></span>
                </div>
              </div>
              {% endfor %}
            </div>
            {% else %}
            <p class="empty-state">이번 주 활성 목표가 없습니다.</p>
            {% endif %}
          </article>

          <article class="primitive primitive-body"
                   data-ui-primitive="weekly_energy_trajectory">
            <div class="primitive-head">
              <h2>주간 에너지 추이</h2>
              <span class="badge">{{ dashboard.weekly.energy.samples }}개 샘플</span>
            </div>
            <div class="weekly-energy"
                 role="img"
                 aria-label="최근 7일의 저장된 평균 에너지. {% for day in dashboard.weekly.energy.days %}{{ day.date }} {% if day.avg_score is not none %}평균 {{ day.avg_score }}점{% else %}데이터 없음{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}">
              {% for day in dashboard.weekly.energy.days %}
              <div class="week-day">
                <div class="week-bar-wrap">
                  {% if day.avg_score is not none %}
                  <span class="week-bar"
                        style="height: {{ day.avg_score }}%"
                        title="{{ day.date }} 평균 {{ day.avg_score }}점"></span>
                  {% else %}
                  <span class="week-bar missing" title="{{ day.date }} 데이터 없음"></span>
                  {% endif %}
                </div>
                <span class="week-score">{{ day.avg_score if day.avg_score is not none else "—" }}</span>
                <span class="week-label">{{ day.date.strftime("%m-%d") }}</span>
              </div>
              {% endfor %}
            </div>
          </article>
        </section>
      </section>

      <section class="scene-panel"
               id="plan"
               role="tabpanel"
               aria-labelledby="lens-adjust"
               data-lens-panel="adjust"
               data-active="false">
        <div class="context-grid">
          <article class="primitive primitive-body"
                   data-ui-primitive="weekly_plan">
            <div class="primitive-head">
              <h2>앞으로 7일의 조율 기준</h2>
              <a href="{{ app_path('/connect') }}{{ token_qs }}">연결 확인</a>
            </div>
            <ul class="signal-list">
              <li class="signal-row">
                <strong>현재 에너지</strong>
                <span>{{ dashboard.energy.score if dashboard.energy.score is not none else "측정 중" }}</span>
              </li>
              <li class="signal-row">
                <strong>캘린더 일정</strong>
                <span>{{ dashboard.plan_events|length }}/{{ dashboard.plan_events_total }}개 표시</span>
              </li>
              <li class="signal-row">
                <strong>결정 대기</strong>
                <span>{{ dashboard.pending_proposals_total }}개</span>
              </li>
              <li class="signal-row">
                <strong>활성 목표</strong>
                <span>{{ dashboard.goals|length }}개</span>
              </li>
            </ul>
            <p class="honesty-note">이 표면은 기존 건강·목표·캘린더 read model을 조합합니다. 새로운 점수나 원인을 계산하지 않습니다.</p>
          </article>

          <article class="primitive primitive-body"
                   data-ui-primitive="calendar_ownership">
            <div class="primitive-head">
              <h2>일정 변경 경계</h2>
            </div>
            <ul class="signal-list">
              <li class="signal-row">
                <strong>HealthMes 관리 블록</strong>
                <span>승인 후 변경 가능</span>
              </li>
              <li class="signal-row">
                <strong>외부 회의·초대 일정</strong>
                <span>기본 고정</span>
              </li>
              <li class="signal-row">
                <strong>Apple·Google 원본</strong>
                <span>출처 보존</span>
              </li>
            </ul>
          </article>
        </div>

        <section class="primitive primitive-body"
                 id="decisions"
                 aria-labelledby="decisions-title"
                 data-ui-primitive="decision_history">
          <div class="primitive-head">
            <h2 id="decisions-title">최근 판단</h2>
            <a href="{{ dashboard.decisions_url }}">전체 판단 보기</a>
          </div>
          {% if dashboard.recent_decisions %}
          <ul class="decision-list">
            {% for decision in dashboard.recent_decisions %}
            <li>
              <a href="{{ decision.url }}">
                <strong>{{ decision.summary }}</strong>
                <span class="decision-meta">
                  <span class="badge kind-{{ decision.kind }}">{{ kind_labels.get(decision.kind, decision.kind) }}</span>
                  <span>{{ format_rel(decision.created_at) }}</span>
                </span>
              </a>
            </li>
            {% endfor %}
          </ul>
          {% else %}
          <p class="empty-state">아직 기록된 판단이 없습니다.</p>
          {% endif %}
        </section>
      </section>

      <section class="scene-panel"
               id="history"
               role="tabpanel"
               aria-labelledby="lens-change"
               data-lens-panel="change"
               data-active="false">
        <article class="primitive primitive-body" data-ui-primitive="outcome_summary">
          <div class="primitive-head">
            <h2>이번 주 결과</h2>
            <a href="{{ dashboard.weekly_url }}">주간 리포트 열기</a>
          </div>
          <div class="outcome-stats">
            <div class="outcome-stat">
              <strong>{{ dashboard.weekly.energy.overall_avg if dashboard.weekly.energy.overall_avg is not none else "—" }}</strong>
              <span>평균 에너지</span>
            </div>
            <div class="outcome-stat">
              <strong>{{ dashboard.weekly.schedule.acceptance_pct if dashboard.weekly.schedule.acceptance_pct is not none else "—" }}{% if dashboard.weekly.schedule.acceptance_pct is not none %}%{% endif %}</strong>
              <span>제안 수용률</span>
            </div>
            <div class="outcome-stat">
              <strong>{{ dashboard.weekly.decisions.count }}</strong>
              <span>판단 기록</span>
            </div>
          </div>
          <details class="progressive">
            <summary>집계 범위와 한계</summary>
            <p class="muted">{{ dashboard.weekly.week_start }}부터 {{ dashboard.weekly.week_end }}까지 저장된 결과입니다. 수용률만으로 건강 효과를 단정하지 않습니다.</p>
          </details>
        </article>

        <div class="history-grid">
          <article class="primitive primitive-body" data-ui-primitive="insight_list">
            <div class="primitive-head">
              <h2>최근 관찰된 패턴</h2>
            </div>
            {% if dashboard.recent_insights %}
            <div class="insight-list">
              {% for insight in dashboard.recent_insights %}
              <div class="insight-item">
                <strong>{{ insight.statement }}</strong>
                <span class="insight-meta">
                  <span>{{ format_rel(insight.created_at) }}</span>
                  {% if insight.confidence is not none %}
                  <span class="badge">confidence {{ "%.0f"|format(insight.confidence * 100) }}%</span>
                  {% endif %}
                </span>
              </div>
              {% endfor %}
            </div>
            {% else %}
            <p class="empty-state">아직 비교할 인사이트가 없습니다.</p>
            {% endif %}
          </article>

          <article class="primitive primitive-body" data-ui-primitive="learning_loop">
            <div class="primitive-head">
              <h2>결정이 다음 판단으로 이어지는 방식</h2>
            </div>
            <ul class="signal-list">
              <li class="signal-row">
                <strong>상태</strong>
                <span>건강·에너지·일정</span>
              </li>
              <li class="signal-row">
                <strong>행동</strong>
                <span>수락·수정·거절</span>
              </li>
              <li class="signal-row">
                <strong>결과</strong>
                <span>집중·회복·완료</span>
              </li>
            </ul>
            <p class="honesty-note">현재 저장된 결과가 부족하면 모름으로 남깁니다. 상관관계를 원인으로 표현하지 않습니다.</p>
          </article>
        </div>
      </section>
    </div>
  </div>

  <details class="advanced" id="advanced">
    <summary>Advanced · 연결, 원시 데이터, 진단</summary>
    <div class="advanced-body">
      <div class="connection-list" aria-label="캘린더와 웨어러블 연결 상태">
        {% for connection in dashboard.calendar_connections %}
        <span class="connection-chip">
          {{ connection.label }} · {{ "연결됨" if connection.connected else "설정 필요" }}
        </span>
        {% endfor %}
      </div>

      <div class="advanced-links">
        <a href="{{ app_path('/connect') }}{{ token_qs }}">
          <strong>Connections</strong><br>
          <span class="muted">Google · iCloud · Wearables 설정</span>
        </a>
        <a href="{{ app_path('/sleep') }}{{ token_qs }}">
          <strong>Actual sleep</strong><br>
          <span class="muted">수면 원본과 캘린더 비교</span>
        </a>
        <a href="{{ dashboard.decisions_url }}">
          <strong>Decision history</strong><br>
          <span class="muted">판단 트리와 근거 전체 보기</span>
        </a>
        <a href="{{ dashboard.weekly_url }}">
          <strong>Weekly report</strong><br>
          <span class="muted">장기 집계와 변화 검토</span>
        </a>
        <a href="{{ app_path('/storage') }}{{ token_qs }}">
          <strong>Storage & diagnostics</strong><br>
          <span class="muted">저장소 상태와 운영 진단</span>
        </a>
        <div class="advanced-item" data-ui-primitive="nutrition_summary">
          <strong>오늘 섭취 {{ dashboard.nutrition.interaction_count }}건</strong><br>
          {% if dashboard.nutrition.latest_items %}
          <span class="muted">
            {{ dashboard.nutrition.latest_items|join(", ") }}
            · 확인 완료 {{ dashboard.nutrition.confirmed_count }}건
          </span>
          {% else %}
          <span class="muted">오늘 기록된 식사나 섭취가 없습니다.</span>
          {% endif %}
        </div>
      </div>

      <p class="honesty-note">
        원시 건강 데이터, provider 연결, 동기화 충돌, 전체 판단 근거와 운영 진단은
        기본 화면에서 숨깁니다. 이 대시보드는 읽기 전용이며 캘린더를 직접 변경하지 않습니다.
      </p>
    </div>
  </details>

  <section class="command-dock no-print"
           id="command-dock"
           data-command-dock
           aria-label="음성 및 텍스트 명령 독">
    <button class="command-voice"
            type="button"
            disabled
            aria-label="웹에서는 음성 명령을 실행할 수 없습니다">Speak</button>
    <div class="command-field">
      <label for="command-preview">HealthMes에 말하거나 입력하기</label>
      <input id="command-preview"
             type="text"
             value=""
             placeholder="예: 오늘 오후 집중 시간을 회복 상태에 맞춰 조율해줘"
             readonly
             aria-readonly="true">
    </div>
    <button class="command-send" type="button" disabled>실행</button>
    <p class="command-note">웹은 읽기 전용입니다. 음성·텍스트 명령과 Yes/No 실행은 iPhone 또는 Mac 앱에서 합니다.</p>
  </section>
</div>

<script>
(function () {
  "use strict";
  var shell = document.querySelector("[data-control-shell]");
  if (!shell) { return; }

  var tabs = Array.prototype.slice.call(shell.querySelectorAll("[data-lens-target]"));
  var panels = Array.prototype.slice.call(shell.querySelectorAll("[data-lens-panel]"));
  var valid = { now: true, adjust: true, change: true };

  function lensFromLocation() {
    var path = window.location.pathname.replace(/\/+$/, "");
    var hash = window.location.hash;
    if (path.endsWith("/plan") || path.endsWith("/decisions")
        || hash === "#plan" || hash === "#decisions") {
      return "adjust";
    }
    if (path.endsWith("/history") || hash === "#history") {
      return "change";
    }
    return "now";
  }

  function selectLens(lens, nextURL) {
    if (!valid[lens]) { lens = "now"; }
    tabs.forEach(function (tab) {
      var selected = tab.getAttribute("data-lens-target") === lens;
      tab.setAttribute("aria-selected", String(selected));
      tab.setAttribute("tabindex", selected ? "0" : "-1");
    });
    panels.forEach(function (panel) {
      var selected = panel.getAttribute("data-lens-panel") === lens;
      panel.setAttribute("data-active", String(selected));
      panel.setAttribute("aria-hidden", String(!selected));
    });
    shell.setAttribute("data-enhanced", "true");
    if (nextURL && window.history && window.history.pushState) {
      window.history.pushState({ lens: lens }, "", nextURL);
    }
  }

  tabs.forEach(function (tab) {
    tab.addEventListener("click", function (event) {
      event.preventDefault();
      selectLens(tab.getAttribute("data-lens-target"), tab.href);
    });
    tab.addEventListener("keydown", function (event) {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") { return; }
      event.preventDefault();
      var current = tabs.indexOf(tab);
      var offset = event.key === "ArrowRight" ? 1 : -1;
      var next = tabs[(current + offset + tabs.length) % tabs.length];
      selectLens(next.getAttribute("data-lens-target"), next.href);
      next.focus();
    });
  });

  window.addEventListener("popstate", function () {
    selectLens(lensFromLocation(), null);
  });
  selectLens(lensFromLocation(), null);
})();
</script>
{% endblock %}
