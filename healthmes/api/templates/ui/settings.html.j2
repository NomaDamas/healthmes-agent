{% extends "ui/_base.html.j2" %}

{% block title %}통합 설정 — HealthMes{% endblock %}
{% block crumb %}<span class="crumb">/ 통합 설정</span>{% endblock %}

{% block head %}
<style>
  .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 0.9rem; }
  .settings-grid .card { margin: 0; }
  .field { display: grid; gap: 0.25rem; margin: 0.75rem 0; }
  .field label { font-weight: 700; font-size: 0.84rem; }
  .field input, .field select {
    width: 100%; border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem; color: var(--ink); background: var(--glass-solid); font: inherit;
  }
  .toggle { display: flex; gap: 0.6rem; align-items: center; margin: 0.7rem 0; }
  .toggle input { width: 1.15rem; height: 1.15rem; }
  .primary {
    border: 1px solid var(--brand); border-radius: var(--radius-sm);
    background: var(--brand); color: #fff; padding: 0.7rem 1rem; font: inherit;
    font-weight: 800; cursor: pointer;
  }
  .secondary {
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    background: var(--glass-solid); color: var(--ink); padding: 0.7rem 1rem;
    font: inherit; font-weight: 750; cursor: pointer;
  }
  .status-row { display: flex; justify-content: space-between; gap: 0.8rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line-soft); }
  .status-row:last-child { border-bottom: 0; }
  .qa-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.8rem; }
  .notice { padding: 0.75rem 0.9rem; border-radius: var(--radius-sm); background: var(--brand-soft); margin: 0.8rem 0; }
</style>
{% endblock %}

{% block content %}
<p class="eyebrow">One setup surface</p>
<h1>HealthMes 통합 설정</h1>
<p class="muted">알림, 캘린더, Open Wearables, 공개 URL과 Live QA를 한 화면에서 관리합니다.
  비밀값은 저장 후 다시 표시하지 않습니다.</p>

{% if restart_required %}<p class="notice">설정을 안전하게 저장했습니다.
  실행 중인 작업과 표시 상태는 HealthMes를 재시작한 뒤 새 설정으로 바뀝니다.</p>{% endif %}
{% if qa == "created" %}<p class="notice">Live QA 결정을 만들었습니다. iPhone에서 한 번 새로고침한 뒤
  앱을 닫고 알림 또는 Apple Watch에서 Yes/No를 선택하세요.</p>{% endif %}
{% if qa == "approval-secret-missing" %}<p class="error">승인 비밀키가 없어 QA 결정을 만들 수 없습니다.
  먼저 <code>uv run python scripts/bootstrap.py</code>를 한 번 실행하세요.</p>{% endif %}

{% if local_unlock_url %}
<section class="card">
  <h2>이 Mac에서 편집 잠금 해제</h2>
  <p class="muted">공개 도메인에서는 상태와 QA 링크만 보입니다. 설정 변경과 테스트 결정 생성은
    이 Mac의 loopback 화면에서만 허용됩니다.</p>
  <p><a href="{{ local_unlock_url }}" rel="noreferrer">로컬 설정 화면 열기</a></p>
</section>
{% endif %}

<section class="settings-grid" aria-label="현재 상태">
  <article class="card">
    <h2>Decision Remote</h2>
    <div class="status-row"><span>네이티브 알림</span><strong>{{ "켜짐" if runtime_settings.native_alert_delivery else "꺼짐" }}</strong></div>
    <div class="status-row"><span>스케줄러</span><strong>{{ "켜짐" if runtime_settings.scheduler_enabled else "꺼짐" }}</strong></div>
    <div class="status-row"><span>공개 URL</span><strong class="mono">{{ runtime_settings.public_base_url }}</strong></div>
  </article>
  {% for card in cards %}
  <article class="card">
    <h2>{{ card.label }}</h2>
    <p class="muted">{{ card.detail }}</p>
    <span class="badge">{{ card.badge_label or ("연결됨" if card.connected else "미연결") }}</span>
  </article>
  {% endfor %}
</section>

{% if local_session %}
<form method="post" action="/settings/save">
  <input type="hidden" name="csrf" value="{{ local_session.csrf_token }}">
  <section class="settings-grid" style="margin-top: 0.9rem">
    <article class="card">
      <h2>서비스</h2>
      <div class="field"><label for="public_base_url">공개 URL</label>
        <input id="public_base_url" name="public_base_url" value="{{ settings.public_base_url }}" required></div>
      <div class="field"><label for="timezone">시간대</label>
        <input id="timezone" name="timezone" value="{{ settings.timezone or "" }}" placeholder="Asia/Seoul"></div>
      <label class="toggle"><input type="checkbox" name="scheduler_enabled" value="true"
        {% if settings.scheduler_enabled %}checked{% endif %}> 캘린더·건강 백그라운드 작업 켜기</label>
      <label class="toggle"><input type="checkbox" name="native_alert_delivery" value="true"
        {% if settings.native_alert_delivery %}checked{% endif %}> iPhone·Watch 네이티브 알림 켜기</label>
    </article>

    <article class="card">
      <h2>알림 위생</h2>
      <div class="field"><label for="quiet_hours_start">방해 금지 시작</label>
        <input id="quiet_hours_start" name="quiet_hours_start" type="time" value="{{ settings.quiet_hours_start.strftime("%H:%M") }}"></div>
      <div class="field"><label for="quiet_hours_end">방해 금지 종료</label>
        <input id="quiet_hours_end" name="quiet_hours_end" type="time" value="{{ settings.quiet_hours_end.strftime("%H:%M") }}"></div>
      <div class="field"><label for="alert_daily_budget">하루 최대 알림</label>
        <input id="alert_daily_budget" name="alert_daily_budget" type="number" min="0" value="{{ settings.alert_daily_budget }}"></div>
      <div class="field"><label for="alert_cooldown_minutes">같은 알림 쿨다운(분)</label>
        <input id="alert_cooldown_minutes" name="alert_cooldown_minutes" type="number" min="0" value="{{ settings.alert_cooldown_minutes }}"></div>
    </article>

    <article class="card">
      <h2>Google Calendar</h2>
      <div class="field"><label for="google_calendar_id">Calendar ID</label>
        <input id="google_calendar_id" name="google_calendar_id" value="{{ settings.google_calendar_id }}"></div>
      <div class="field"><label for="google_poll_minutes">동기화 주기(분)</label>
        <input id="google_poll_minutes" name="google_poll_minutes" type="number" min="1" value="{{ settings.google_poll_minutes }}"></div>
      <p><a href="/connect">Google 연결·재연결 관리</a></p>
    </article>

    <article class="card">
      <h2>Apple Calendar · CalDAV</h2>
      <div class="field"><label for="caldav_url">CalDAV URL</label>
        <input id="caldav_url" name="caldav_url" value="{{ settings.caldav_url }}"></div>
      <div class="field"><label for="caldav_calendar_name">캘린더 이름</label>
        <input id="caldav_calendar_name" name="caldav_calendar_name" value="{{ settings.caldav_calendar_name or "" }}" placeholder="기본 캘린더"></div>
      <div class="field"><label for="caldav_poll_minutes">동기화 주기(분)</label>
        <input id="caldav_poll_minutes" name="caldav_poll_minutes" type="number" min="1" value="{{ settings.caldav_poll_minutes }}"></div>
      <p><a href="/connect">iCloud 연결 상태와 앱 암호 안내</a></p>
    </article>

    <article class="card">
      <h2>Open Wearables</h2>
      <div class="field"><label for="ow_base_url">서버 URL</label>
        <input id="ow_base_url" name="ow_base_url" value="{{ settings.ow_base_url }}"></div>
      <div class="field"><label for="ow_user_id">사용자 ID</label>
        <input id="ow_user_id" name="ow_user_id" value="{{ settings.ow_user_id or "" }}"></div>
      <div class="field"><label for="ow_api_key">API Key 변경</label>
        <input id="ow_api_key" name="ow_api_key" type="password" value="" placeholder="비워두면 기존 값 유지"></div>
    </article>

    <article class="card">
      <h2>암호화 백업</h2>
      <div class="field"><label for="backup_provider">Provider</label>
        <select id="backup_provider" name="backup_provider">
          <option value="" {% if not settings.backup_provider %}selected{% endif %}>Local</option>
          <option value="remote_vault" {% if settings.backup_provider == "remote_vault" %}selected{% endif %}>Remote vault</option>
        </select></div>
      <div class="field"><label for="backup_passphrase">백업 암호 변경</label>
        <input id="backup_passphrase" name="backup_passphrase" type="password" value="" placeholder="비워두면 기존 값 유지"></div>
    </article>
  </section>
  <p style="margin-top: 1rem"><button class="primary" type="submit">모든 설정 저장</button></p>
</form>

<section class="card">
  <h2>Live QA</h2>
  <p class="muted">실제 승인 토큰이 붙은 2시간짜리 테스트 결정을 생성합니다. Yes를 누르면 제안이
    <code>accepted</code>가 되고, 연결된 캘린더 동기화 후 <code>pushed</code>가 됩니다.</p>
  <div class="qa-actions">
    <form method="post" action="/settings/qa/decision">
      <input type="hidden" name="csrf" value="{{ local_session.csrf_token }}">
      <button class="primary" type="submit">테스트 결정 만들기</button>
    </form>
    <a class="secondary" href="{{ decision_qa_url }}">결정 기록 보기</a>
    <a class="secondary" href="{{ weekly_qa_url }}">주간 결과 보기</a>
  </div>
</section>
{% else %}
<section class="card">
  <h2>Sake QA 링크</h2>
  <p><a href="{{ decision_qa_url }}">제안·의사결정 기록</a></p>
  <p><a href="{{ weekly_qa_url }}">주간 리포트</a></p>
</section>
{% endif %}
{% endblock %}
