header.site nav.site-nav { display: none; }
header.site .ambience { margin-left: auto; }
main {
  max-width: none;
  padding: 0;
}

.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.workspace-shell {
  --google: #296bd6;
  --apple: #08796c;
  --healthmes: #cf761f;
  --workspace-rail: color-mix(in srgb, var(--glass-solid) 96%, #e8f0ec);
  --workspace-canvas: color-mix(in srgb, var(--glass-solid) 94%, transparent);
  min-height: calc(100vh - 3.65rem);
}

.workspace-topbar {
  display: flex;
  align-items: center;
  min-height: 3.6rem;
  gap: 0.7rem;
  padding: 0.55rem clamp(0.7rem, 2vw, 1.15rem);
  border-bottom: 1px solid var(--glass-line);
  background: color-mix(in srgb, var(--glass-solid) 96%, transparent);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  backdrop-filter: blur(18px) saturate(150%);
}

.workspace-mobile-toggle,
.workspace-icon-button,
.channel-action,
.thread-trigger,
.thread-close,
.category-add,
.channel-create,
.local-composer button,
.thread-composer button,
.dialog-actions button {
  border: 1px solid var(--line-soft);
  background: var(--surface-2);
  color: var(--ink);
  font: inherit;
}

.workspace-mobile-toggle,
.workspace-icon-button,
.thread-close {
  display: none;
  place-items: center;
  width: 2.35rem;
  height: 2.35rem;
  padding: 0;
  border-radius: 11px;
  cursor: pointer;
}

.workspace-heading {
  min-width: 0;
}

.workspace-heading p {
  margin: 0;
  color: var(--ink-3);
  font-size: 0.67rem;
  font-weight: 760;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.workspace-heading h1 {
  margin: 0;
  font-size: 1.02rem;
  line-height: 1.35;
}

.workspace-status {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin-left: auto;
  color: var(--ink-2);
  font-size: 0.72rem;
  white-space: nowrap;
}

.workspace-status span {
  display: inline-flex;
  align-items: center;
  gap: 0.32rem;
}

.workspace-status span::before {
  width: 0.46rem;
  height: 0.46rem;
  border-radius: 50%;
  background: var(--brand);
  content: "";
}

.workspace-status .local-only::before { background: var(--healthmes); }
.workspace-status .storage-status {
  max-width: 20rem;
  color: var(--danger);
  white-space: normal;
}
.workspace-status .storage-status::before { background: var(--danger); }

.storage-reset {
  margin-inline-start: 0.45rem;
  border: 1px solid color-mix(in srgb, var(--danger) 48%, transparent);
  border-radius: 999px;
  padding: 0.2rem 0.5rem;
  color: var(--danger);
  background: transparent;
  font: inherit;
}

.workspace-layout {
  display: grid;
  grid-template-columns: 16.25rem minmax(0, 1fr);
  min-height: calc(100vh - 7.25rem);
}

.workspace-shell[data-thread-open="true"] .workspace-layout {
  grid-template-columns: 16.25rem minmax(0, 1fr) minmax(19rem, 22rem);
}

.workspace-sidebar {
  position: sticky;
  top: 3.65rem;
  align-self: start;
  height: calc(100vh - 3.65rem);
  overflow: auto;
  border-right: 1px solid var(--glass-line);
  background:
    linear-gradient(180deg, rgba(7, 34, 31, 0.97), rgba(9, 55, 48, 0.95));
  -webkit-backdrop-filter: blur(18px) saturate(145%);
  backdrop-filter: blur(18px) saturate(145%);
}

.workspace-identity {
  display: grid;
  gap: 0.15rem;
  padding: 1rem 0.9rem 0.75rem;
}

.workspace-identity strong { color: #f3faf7; }
.workspace-identity span { color: rgba(231, 246, 240, 0.58); }
.workspace-sidebar .sidebar-section-head,
.workspace-sidebar .category-heading { color: rgba(231, 246, 240, 0.58); }
.workspace-sidebar .channel-row { color: rgba(243, 250, 247, 0.76); }
.workspace-sidebar .channel-row:hover {
  background: rgba(255, 255, 255, 0.07);
  color: #fff;
}
.workspace-sidebar .channel-row[aria-current="page"],
.workspace-sidebar .channel-row[aria-selected="true"] {
  background: rgba(111, 224, 194, 0.16);
  box-shadow: inset 3px 0 0 #6fe0c2;
  color: #fff;
}
.workspace-sidebar .channel-glyph {
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.07);
  color: #9ce9d5;
}
.workspace-sidebar .channel-action,
.workspace-sidebar .category-add,
.workspace-sidebar .channel-create,
.workspace-sidebar .sidebar-footer a,
.workspace-sidebar .sidebar-footer button { color: rgba(243, 250, 247, 0.64); }
.workspace-sidebar .sidebar-footer {
  border-color: rgba(255, 255, 255, 0.1);
}

.workspace-identity strong {
  font-size: 0.9rem;
}

.workspace-identity span {
  color: rgba(231, 246, 240, 0.58);
  font-size: 0.68rem;
}

.sidebar-section {
  padding: 0.25rem 0.55rem 0.55rem;
}

.sidebar-section[hidden] { display: none; }

.sidebar-section-head,
.category-heading {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 1.9rem;
  padding: 0 0.35rem;
  color: rgba(231, 246, 240, 0.58);
  font-size: 0.68rem;
  font-weight: 820;
  letter-spacing: 0.075em;
  text-transform: uppercase;
}

.sidebar-section-head span,
.category-heading strong {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-section-head .category-add,
.category-heading .channel-create {
  width: 1.7rem;
  height: 1.7rem;
  margin-left: auto;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: rgba(243, 250, 247, 0.64);
  cursor: pointer;
}

.channel-list {
  display: grid;
  gap: 0.16rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.channel-row-wrap {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 0.1rem;
  align-items: center;
  border-radius: 10px;
}

.channel-transfer {
  grid-column: 1 / -1;
  width: 100%;
  margin-top: 0.25rem;
  border: 1px solid var(--line-soft);
  border-radius: 0.55rem;
  padding: 0.32rem 0.45rem;
  color: var(--ink-2);
  background: color-mix(in srgb, var(--workspace-rail) 88%, transparent);
  font: inherit;
  font-size: 0.68rem;
}

.channel-row-wrap.is-dragging,
.workspace-category.is-dragging {
  opacity: 0.48;
}

.channel-row-wrap.drag-over,
.workspace-category.drag-over {
  box-shadow: inset 0 2px 0 var(--brand);
}

.channel-row {
  display: grid;
  grid-template-columns: 1.55rem minmax(0, 1fr) auto;
  gap: 0.35rem;
  align-items: center;
  min-width: 0;
  min-height: 2.25rem;
  padding: 0.35rem 0.45rem;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--ink-2);
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.channel-row:hover,
.channel-row[aria-selected="true"] {
  background: var(--surface-2);
  color: var(--ink);
}

.channel-row[aria-selected="true"] {
  box-shadow: inset 3px 0 0 var(--brand);
}

.channel-glyph {
  display: grid;
  place-items: center;
  width: 1.45rem;
  height: 1.45rem;
  border: 1px solid var(--line-soft);
  border-radius: 7px;
  background: var(--glass-solid);
  color: var(--brand-deep);
  font-size: 0.64rem;
  font-weight: 850;
}

.channel-label {
  min-width: 0;
  overflow: hidden;
  font-size: 0.78rem;
  font-weight: 710;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-count {
  min-width: 1.25rem;
  padding: 0.08rem 0.35rem;
  border-radius: 999px;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 0.62rem;
  font-weight: 800;
  text-align: center;
}

.channel-action {
  display: grid;
  place-items: center;
  width: 1.7rem;
  height: 1.7rem;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--ink-3);
  cursor: pointer;
  opacity: 0;
}

.channel-row-wrap:hover .channel-action,
.channel-action:focus-visible,
.channel-action[data-active="true"] {
  opacity: 1;
}

.channel-move-actions {
  display: flex;
  gap: 0.08rem;
}

.channel-move-actions .channel-action {
  width: 1.4rem;
}

.workspace-category {
  margin-top: 0.2rem;
}

.category-toggle {
  display: grid;
  place-items: center;
  width: 1.35rem;
  height: 1.35rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  transition: transform 140ms ease;
}

.workspace-category[data-collapsed="true"] .category-toggle {
  transform: rotate(-90deg);
}

.workspace-category[data-collapsed="true"] .channel-list {
  display: none;
}

.category-menu {
  display: flex;
  margin-left: auto;
}

.category-menu button {
  width: 1.55rem;
  height: 1.55rem;
  padding: 0;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: rgba(243, 250, 247, 0.64);
  cursor: pointer;
}

.sidebar-footer {
  display: grid;
  gap: 0.35rem;
  margin: 0.5rem 0.75rem 1rem;
  padding-top: 0.7rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar-footer button,
.sidebar-footer a {
  padding: 0.45rem 0.55rem;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: rgba(243, 250, 247, 0.64);
  font: inherit;
  font-size: 0.72rem;
  font-weight: 720;
  text-align: left;
  cursor: pointer;
}

.sidebar-footer button:hover,
.sidebar-footer a:hover {
  background: rgba(255, 255, 255, 0.07);
  color: #fff;
  text-decoration: none;
}

.workspace-main {
  min-width: 0;
  padding: clamp(0.9rem, 2.4vw, 1.6rem);
  background:
    radial-gradient(circle at 12% 0%, rgba(22, 128, 108, 0.08), transparent 30rem),
    radial-gradient(circle at 94% 12%, rgba(207, 118, 31, 0.07), transparent 28rem);
}

.channel-header {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  min-height: 3.4rem;
  margin-bottom: 0.9rem;
  padding: 0.1rem 0.15rem 0.8rem;
  border-bottom: 1px solid var(--line-soft);
}

.channel-header-copy {
  min-width: 0;
}

.channel-header h2 {
  margin: 0;
  font-size: clamp(1.12rem, 2.5vw, 1.42rem);
}

.channel-header p {
  margin: 0.15rem 0 0;
  color: var(--ink-2);
  font-size: 0.76rem;
}

.channel-header-actions {
  display: flex;
  gap: 0.35rem;
  margin-left: auto;
}

.channel-panel {
  display: grid;
  gap: 0.85rem;
  max-width: 82rem;
  margin: 0 auto;
}

.workspace-shell[data-enhanced="true"] .channel-panel:not([data-active="true"]) {
  display: none;
}

.canvas-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 0.85rem;
}

.canvas-span-12 { grid-column: span 12; }
.canvas-span-8 { grid-column: span 8; }
.canvas-span-7 { grid-column: span 7; }
.canvas-span-6 { grid-column: span 6; }
.canvas-span-5 { grid-column: span 5; }
.canvas-span-4 { grid-column: span 4; }

.primitive {
  position: relative;
  min-width: 0;
  margin: 0;
  border: 1px solid var(--glass-line);
  border-color: color-mix(in srgb, var(--line) 82%, transparent);
  border-radius: 20px;
  background: var(--workspace-canvas);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  backdrop-filter: blur(16px) saturate(140%);
  box-shadow: 0 1px 2px rgba(17, 38, 30, 0.04), 0 16px 42px rgba(17, 38, 30, 0.07);
}

.primitive-body {
  padding: clamp(0.85rem, 2vw, 1.1rem);
}

.primitive-head {
  display: flex;
  align-items: flex-start;
  gap: 0.65rem;
  margin-bottom: 0.7rem;
}

.primitive-head-copy {
  min-width: 0;
}

.primitive-head h3 {
  margin: 0;
  font-size: 0.95rem;
}

.primitive-head p {
  margin: 0.12rem 0 0;
  color: var(--ink-3);
  font-size: 0.7rem;
}

.primitive-head > a,
.primitive-head .thread-trigger {
  margin-left: auto;
}

.thread-trigger {
  flex: 0 0 auto;
  padding: 0.28rem 0.55rem;
  border-radius: 9px;
  color: var(--ink-2);
  font-size: 0.68rem;
  font-weight: 760;
  cursor: pointer;
}

.thread-trigger:hover {
  border-color: var(--brand);
  color: var(--brand-deep);
}

.capacity-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: clamp(0.75rem, 2vw, 1.15rem);
  align-items: center;
  padding: clamp(0.9rem, 2.2vw, 1.2rem);
}

.capacity-score {
  display: grid;
  place-items: center;
  width: 5.1rem;
  aspect-ratio: 1;
  border-radius: 50%;
  background:
    radial-gradient(circle closest-side, var(--glass-solid) 76%, transparent 78% 99%),
    conic-gradient(
      var(--brand) calc(var(--capacity-value, 0) * 1%),
      var(--surface-2) 0
    );
  color: var(--brand-deep);
  font-size: 1.35rem;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.capacity-score.is-missing {
  border: 1px dashed var(--line);
  background: var(--surface-2);
}

.capacity-score span {
  display: block;
  color: var(--ink-3);
  font-size: 0.58rem;
  line-height: 1;
}

.capacity-copy h3 {
  margin: 0 0 0.2rem;
  font-size: clamp(1.08rem, 2.2vw, 1.42rem);
  letter-spacing: -0.015em;
  line-height: 1.42;
}

.capacity-copy p {
  margin: 0;
  color: var(--ink-2);
  font-size: 0.74rem;
}

.capacity-meta {
  display: grid;
  gap: 0.28rem;
  justify-items: end;
  color: var(--ink-2);
  font-size: 0.7rem;
  text-align: right;
}

.metric-grid,
.outcome-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.55rem;
}

.metric,
.outcome-stat {
  min-width: 0;
  padding: 0.72rem;
  border: 1px solid var(--line-soft);
  border-radius: 12px;
  background: var(--surface-2);
}

.metric strong,
.outcome-stat strong {
  display: block;
  font-size: 1.15rem;
  line-height: 1.2;
}

.metric span,
.outcome-stat span {
  display: block;
  margin-top: 0.2rem;
  color: var(--ink-2);
  font-size: 0.66rem;
}

.calendar-toolbar {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  margin-bottom: 0.75rem;
}

.calendar-title {
  min-width: 0;
}

.calendar-title h3 { margin: 0; }

.calendar-freshness,
.provider-legend,
.event-meta,
.decision-meta,
.insight-meta {
  display: flex;
  align-items: center;
  gap: 0.38rem;
  flex-wrap: wrap;
}

.calendar-freshness {
  margin-top: 0.22rem;
  color: var(--ink-3);
  font-size: 0.66rem;
  font-weight: 680;
}

.calendar-freshness span {
  display: inline-flex;
  align-items: center;
  gap: 0.28rem;
}

.calendar-freshness span::before {
  width: 0.4rem;
  height: 0.4rem;
  border-radius: 50%;
  background: var(--brand);
  content: "";
}

.calendar-freshness .unconfirmed::before { background: var(--healthmes); }
.calendar-freshness .stale::before,
.calendar-freshness .future-skew::before { background: var(--danger); }

.provider-legend {
  margin-left: auto;
  color: var(--ink-2);
  font-size: 0.68rem;
  font-weight: 700;
}

.provider-key,
.provider-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.provider-dot,
.provider-badge::before {
  width: 0.48rem;
  height: 0.48rem;
  border-radius: 50%;
  background: var(--provider-color, var(--ink-3));
  content: "";
}

.provider-google { --provider-color: var(--google); }
.provider-caldav { --provider-color: var(--apple); }
.provider-healthmes { --provider-color: var(--healthmes); }

.energy-chart {
  margin: 0 0 0.8rem;
  padding: 0.72rem 0.75rem 0.45rem;
  border: 1px solid var(--line-soft);
  border-radius: 13px;
  background:
    linear-gradient(180deg, var(--brand-wash), color-mix(in srgb, var(--brand-wash) 42%, transparent));
}

.energy-chart figcaption {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.6rem;
  margin-bottom: 0.25rem;
}

.energy-chart figcaption strong { font-size: 0.76rem; }
.energy-chart figcaption span { color: var(--ink-3); font-size: 0.64rem; }

.energy-svg {
  display: block;
  width: 100%;
  height: auto;
  min-height: 5rem;
  overflow: visible;
}

.energy-grid { stroke: var(--line-soft); stroke-width: 1; }
.energy-bar { fill: var(--brand); opacity: 0.82; }
.energy-missing { fill: var(--line-soft); }
.energy-axis {
  fill: var(--ink-2);
  font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  font-size: 8px;
}

.calendar-timeline {
  position: relative;
  display: grid;
  gap: 0.48rem;
  margin: 0;
  padding: 0 0 0 1.2rem;
  list-style: none;
}

.calendar-timeline::before {
  position: absolute;
  top: 0.45rem;
  bottom: 0.45rem;
  left: 0.3rem;
  width: 1px;
  background: var(--line);
  content: "";
}

.calendar-event {
  --provider-color: var(--ink-3);
  position: relative;
  display: grid;
  grid-template-columns: minmax(7.7rem, auto) minmax(0, 1fr) auto;
  gap: 0.7rem;
  min-width: 0;
  padding: 0.72rem 0.78rem;
  border: 1px solid var(--line-soft);
  border-left: 4px solid var(--provider-color);
  border-radius: 13px;
  background: color-mix(in srgb, var(--surface) 70%, var(--surface-2));
}

.calendar-event[data-duration-minutes] {
  min-height: clamp(
    3.5rem,
    calc(var(--duration-minutes, 60) * 0.055rem),
    12rem
  );
}

.calendar-event[data-gap-minutes] {
  margin-top: clamp(
    0rem,
    calc(var(--gap-minutes, 0) * 0.055rem),
    6rem
  );
}

.calendar-event::before {
  position: absolute;
  top: 1rem;
  left: -1.47rem;
  width: 0.6rem;
  height: 0.6rem;
  border: 2px solid var(--glass-solid);
  border-radius: 50%;
  background: var(--provider-color);
  box-shadow: 0 0 0 1px var(--provider-color);
  content: "";
}

.calendar-event.provider-google { --provider-color: var(--google); }
.calendar-event.provider-caldav { --provider-color: var(--apple); }

.event-time {
  color: var(--ink-2);
  font-size: 0.69rem;
  font-variant-numeric: tabular-nums;
  line-height: 1.45;
}

.event-copy {
  min-width: 0;
}

.event-copy strong {
  display: block;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.event-meta,
.decision-meta,
.insight-meta {
  margin-top: 0.2rem;
  color: var(--ink-3);
  font-size: 0.66rem;
}

.provider-badge {
  color: var(--ink-2);
  font-weight: 790;
}

.proposal-preview-event {
  --provider-color: var(--healthmes);
  border-style: dashed;
  background: color-mix(in srgb, var(--healthmes) 8%, var(--surface-2));
}

.change-preview {
  display: grid;
  gap: 0.45rem;
  margin: 0;
}

.change-state {
  display: grid;
  grid-template-columns: 4.3rem minmax(0, 1fr);
  gap: 0.5rem;
  padding: 0.62rem 0.68rem;
  border: 1px solid var(--line-soft);
  border-radius: 11px;
  background: var(--surface-2);
}

.change-state.after {
  border-color: color-mix(in srgb, var(--healthmes) 45%, var(--line-soft));
  background: color-mix(in srgb, var(--healthmes) 9%, var(--surface-2));
}

.change-state dt {
  color: var(--ink-3);
  font-size: 0.66rem;
  font-weight: 780;
}

.change-state dd {
  min-width: 0;
  margin: 0;
  font-size: 0.75rem;
  font-weight: 730;
}

.change-arrow {
  color: var(--healthmes);
  font-weight: 850;
  text-align: center;
}

.semantic-result {
  display: grid;
  gap: 0.5rem;
  margin: 0.7rem 0 0;
}

.semantic-row {
  display: grid;
  grid-template-columns: 3.2rem minmax(0, 1fr);
  gap: 0.5rem;
  margin: 0;
  color: var(--ink-2);
  font-size: 0.75rem;
}

.semantic-row dt {
  color: var(--brand-deep);
  font-weight: 810;
}

.semantic-row dd { margin: 0; }

.decision-actions {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
  margin-top: 0.75rem;
  padding: 0.68rem;
  border: 1px solid rgba(177, 114, 30, 0.3);
  border-radius: 11px;
  background: rgba(177, 114, 30, 0.08);
}

.decision-actions p {
  flex: 1 1 13rem;
  margin: 0;
  color: var(--ink-2);
  font-size: 0.7rem;
}

.goal-list,
.signal-list,
.decision-list,
.insight-list,
.local-feed,
.thread-messages {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.goal-item {
  padding: 0.68rem 0;
  border-bottom: 1px solid var(--line-soft);
}

.goal-item:last-child { border-bottom: 0; }

.goal-top,
.signal-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.7rem;
}

.goal-top span,
.signal-row span {
  color: var(--ink-2);
  font-size: 0.68rem;
}

.progress-track {
  height: 0.48rem;
  margin-top: 0.5rem;
  overflow: hidden;
  border-radius: 999px;
  background: var(--line-soft);
}

.progress-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--brand), #d3a52e);
}

.weekly-energy {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.32rem;
  align-items: end;
  min-height: 8rem;
  padding-top: 0.4rem;
}

.week-day {
  display: grid;
  grid-template-rows: 1fr auto auto;
  gap: 0.22rem;
  min-width: 0;
  height: 7.5rem;
  text-align: center;
}

.week-bar-wrap {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-height: 5.1rem;
  border-bottom: 1px solid var(--line-soft);
}

.week-bar {
  width: min(1rem, 70%);
  min-height: 0.18rem;
  border-radius: 999px 999px 0.2rem 0.2rem;
  background: var(--brand);
  opacity: 0.8;
}

.week-bar.missing {
  height: 0.18rem;
  background: var(--line);
}

.week-score {
  color: var(--ink-2);
  font-size: 0.66rem;
}

.week-label {
  overflow: hidden;
  color: var(--ink-3);
  font-size: 0.6rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal-row,
.decision-list li,
.insight-item,
.local-post,
.thread-message {
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--line-soft);
}

.signal-row:last-child,
.decision-list li:last-child,
.insight-item:last-child,
.local-post:last-child,
.thread-message:last-child {
  border-bottom: 0;
}

.decision-list a {
  display: block;
  color: inherit;
}

.decision-list a:hover { text-decoration: none; }

.decision-list strong,
.insight-item strong {
  display: block;
  line-height: 1.45;
}

.honesty-note,
.local-only-note {
  margin: 0.65rem 0 0;
  padding: 0.65rem 0.72rem;
  border-left: 3px solid var(--brand);
  border-radius: 4px 10px 10px 4px;
  background: var(--brand-wash);
  color: var(--ink-2);
  font-size: 0.72rem;
}

.empty-state {
  margin: 0;
  padding: 0.8rem 0;
  color: var(--ink-2);
}

.advanced {
  padding: 0.82rem 0.9rem;
}

.advanced > summary {
  cursor: pointer;
  color: var(--ink-2);
  font-size: 0.76rem;
  font-weight: 760;
}

.advanced-body {
  display: grid;
  gap: 0.7rem;
  margin-top: 0.75rem;
}

.connection-list {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.connection-chip {
  padding: 0.24rem 0.54rem;
  border: 1px solid var(--line-soft);
  border-radius: 999px;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 0.67rem;
  font-weight: 720;
}

.advanced-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  gap: 0.5rem;
}

.advanced-links a,
.advanced-item {
  padding: 0.7rem 0.75rem;
  border: 1px solid var(--line-soft);
  border-radius: 11px;
  background: var(--surface-2);
  color: var(--ink);
}

.advanced-links a:hover {
  border-color: var(--brand);
  text-decoration: none;
}

.agent-canvas {
  display: grid;
  grid-template-rows: minmax(12rem, 1fr) auto;
  min-height: min(36rem, calc(100vh - 12rem));
  overflow: hidden;
}

.local-feed {
  align-content: start;
  max-height: 32rem;
  overflow: auto;
  padding: 0 1rem;
}

.local-post-head,
.thread-message-head {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin-bottom: 0.2rem;
  color: var(--ink-3);
  font-size: 0.66rem;
}

.local-post-head strong,
.thread-message-head strong {
  color: var(--ink);
}

.local-post p,
.thread-message p {
  margin: 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.local-composer,
.thread-composer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.5rem;
  padding: 0.7rem;
  border-top: 1px solid var(--line-soft);
  background: var(--glass-solid);
}

.local-composer textarea,
.thread-composer textarea {
  width: 100%;
  min-height: 3rem;
  max-height: 10rem;
  resize: vertical;
  padding: 0.65rem 0.7rem;
  border: 1px solid var(--line);
  border-radius: 11px;
  outline: 0;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
}

.local-composer textarea:focus,
.thread-composer textarea:focus {
  border-color: var(--brand);
  box-shadow: 0 0 0 3px var(--brand-soft);
}

.local-composer button,
.thread-composer button {
  align-self: end;
  min-height: 2.65rem;
  padding: 0 0.8rem;
  border-radius: 11px;
  background: var(--brand);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 800;
  cursor: pointer;
}

.composer-note {
  grid-column: 1 / -1;
  margin: -0.1rem 0.2rem 0;
  color: var(--ink-3);
  font-size: 0.64rem;
}

.custom-canvas-intro {
  display: grid;
  gap: 0.45rem;
  padding: 1rem;
}

.custom-canvas-intro h3 { margin: 0; }
.custom-canvas-intro p { margin: 0; color: var(--ink-2); }

.workspace-thread-panel {
  position: sticky;
  top: 3.65rem;
  align-self: start;
  height: calc(100vh - 3.65rem);
  overflow: hidden;
  border-left: 1px solid var(--glass-line);
  background: var(--workspace-rail);
  -webkit-backdrop-filter: blur(18px) saturate(145%);
  backdrop-filter: blur(18px) saturate(145%);
}

.workspace-thread-panel[hidden] { display: none; }

.thread-panel-inner {
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr) auto;
  height: 100%;
}

.thread-header {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  padding: 0.85rem;
  border-bottom: 1px solid var(--line-soft);
}

.thread-header-copy {
  min-width: 0;
}

.thread-header h2 {
  margin: 0;
  font-size: 0.95rem;
}

.thread-header p {
  margin: 0.1rem 0 0;
  color: var(--ink-3);
  font-size: 0.66rem;
}

.thread-close {
  display: grid;
  margin-left: auto;
}

.thread-anchor-preview {
  margin: 0.75rem 0.8rem 0;
  padding: 0.65rem;
  border: 1px solid var(--line-soft);
  border-radius: 11px;
  background: var(--surface-2);
}

.thread-anchor-preview strong {
  display: block;
  font-size: 0.78rem;
}

.thread-anchor-preview span {
  color: var(--ink-3);
  font-size: 0.65rem;
}

.thread-messages {
  overflow: auto;
  padding: 0.5rem 0.85rem;
}

.workspace-dialog {
  width: min(28rem, calc(100% - 1.5rem));
  padding: 0;
  border: 1px solid var(--glass-line);
  border-radius: 17px;
  background: var(--glass-solid);
  color: var(--ink);
  box-shadow: 0 24px 70px rgba(17, 38, 30, 0.24);
}

.workspace-dialog::backdrop {
  background: rgba(16, 28, 23, 0.35);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}

.dialog-body {
  display: grid;
  gap: 0.75rem;
  padding: 1rem;
}

.dialog-body h2 {
  margin: 0;
}

.dialog-field {
  display: grid;
  gap: 0.28rem;
}

.dialog-field label {
  color: var(--ink-2);
  font-size: 0.7rem;
  font-weight: 760;
}

.dialog-field input,
.dialog-field select {
  width: 100%;
  min-height: 2.55rem;
  padding: 0.55rem 0.65rem;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.45rem;
}

.dialog-actions button {
  min-height: 2.35rem;
  padding: 0 0.75rem;
  border-radius: 10px;
  cursor: pointer;
}

.dialog-actions .primary {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
  font-weight: 800;
}

.sidebar-scrim {
  display: none;
}

@media (max-width: 1180px) {
  .workspace-shell[data-thread-open="true"] .workspace-layout {
    grid-template-columns: 15.5rem minmax(0, 1fr);
  }

  .workspace-thread-panel {
    position: fixed;
    top: 3.65rem;
    right: 0;
    z-index: 32;
    width: min(23rem, 92vw);
    box-shadow: -16px 0 44px rgba(17, 38, 30, 0.18);
  }
}

@media (max-width: 900px) {
  .canvas-span-8,
  .canvas-span-7,
  .canvas-span-6,
  .canvas-span-5,
  .canvas-span-4 {
    grid-column: span 12;
  }
}

@media (max-width: 760px) {
  .workspace-mobile-toggle,
  .workspace-icon-button {
    display: grid;
  }

  .workspace-status .updated-label { display: none; }

  .workspace-layout,
  .workspace-shell[data-thread-open="true"] .workspace-layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .workspace-sidebar {
    position: fixed;
    top: 3.65rem;
    bottom: 0;
    left: 0;
    z-index: 34;
    width: min(18rem, 88vw);
    height: auto;
    box-shadow: 14px 0 38px rgba(17, 38, 30, 0.18);
    transform: translateX(-105%);
    transition: transform 180ms ease;
  }

  .workspace-shell[data-sidebar-open="true"] .workspace-sidebar {
    transform: translateX(0);
  }

  .sidebar-scrim {
    position: fixed;
    inset: 3.65rem 0 0;
    z-index: 33;
    border: 0;
    background: rgba(16, 28, 23, 0.3);
  }

  .workspace-shell[data-sidebar-open="true"] .sidebar-scrim {
    display: block;
  }

  .capacity-card {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .capacity-meta {
    grid-column: 1 / -1;
    justify-items: start;
    text-align: left;
  }
}

@media (max-width: 540px) {
  .workspace-main { padding: 0.6rem; }
  .workspace-topbar { padding-inline: 0.55rem; }
  .workspace-status .local-only { display: none; }
  .channel-header { margin-bottom: 0.65rem; }
  .primitive { border-radius: 14px; }
  .calendar-toolbar { display: grid; }
  .provider-legend { margin-left: 0; }
  .calendar-event {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.28rem 0.55rem;
  }
  .calendar-event .event-time {
    grid-column: 1 / -1;
  }
  .metric-grid,
  .outcome-stats {
    grid-template-columns: 1fr;
  }
  .local-composer,
  .thread-composer {
    grid-template-columns: 1fr;
  }
  .local-composer button,
  .thread-composer button {
    justify-self: end;
  }
}

@media (prefers-reduced-motion: reduce) {
  .workspace-sidebar,
  .category-toggle {
    transition: none;
  }
}
