(function () {
  "use strict";

  var shell = document.querySelector("[data-workspace-shell]");
  if (!shell) { return; }

  var SCHEMA_VERSION = 1;
  var MAX_CATEGORIES = 40;
  var MAX_CHANNELS_PER_CATEGORY = 80;
  var MAX_THREADS = 500;
  var MAX_MESSAGES_PER_FEED = 500;
  var SYSTEM_CHANNELS = {
    overview: {
      title: "overview",
      description: "현재 상태, 일정, 목표, 필요한 결정"
    },
    calendar: {
      title: "calendar",
      description: "Apple·Google Calendar와 HealthMes 제안"
    },
    insights: {
      title: "insights",
      description: "저장된 웰니스 추이와 관찰된 패턴"
    },
    decisions: {
      title: "decisions",
      description: "제안, 판단 근거, 이후 결과"
    },
    agent: {
      title: "agent",
      description: "이 브라우저에만 저장되는 로컬 작업 캔버스"
    }
  };
  var CANVAS_LABELS = {
    dashboard: "Dashboard",
    calendar: "Calendar",
    visualization: "Visualization",
    decision: "Decision feed",
    conversation: "Conversation",
    mixed: "Mixed canvas"
  };

  var sidebar = shell.querySelector("[data-workspace-sidebar]");
  var localCategoriesMount = shell.querySelector("[data-local-categories]");
  var favoritesSection = shell.querySelector("[data-favorites-section]");
  var favoritesList = shell.querySelector("[data-favorites-list]");
  var systemList = shell.querySelector("[data-system-channels]");
  var customPanelsMount = shell.querySelector("[data-custom-panels]");
  var channelTitle = shell.querySelector("[data-current-channel-title]");
  var channelDescription = shell.querySelector("[data-current-channel-description]");
  var threadPanel = shell.querySelector("[data-thread-panel]");
  var threadTitle = shell.querySelector("[data-thread-title]");
  var threadKind = shell.querySelector("[data-thread-kind]");
  var threadMessages = shell.querySelector("[data-thread-messages]");
  var threadDraft = shell.querySelector("[data-thread-draft]");
  var categoryDialog = shell.querySelector("[data-category-dialog]");
  var channelDialog = shell.querySelector("[data-channel-dialog]");
  var categoryInput = shell.querySelector("[data-category-name]");
  var channelInput = shell.querySelector("[data-channel-name]");
  var channelCategorySelect = shell.querySelector("[data-channel-category]");
  var channelKindSelect = shell.querySelector("[data-channel-kind]");
  var storageStatus = shell.querySelector("[data-storage-status]");
  var mobileToggle = shell.querySelector('[data-action="toggle-sidebar"]');
  var workspaceMain = shell.querySelector(".workspace-main");
  var activeThreadId = null;
  var dragPayload = null;
  var previousThreadFocus = null;
  var storageMode = "writable";
  var dashboardRoot = window.location.pathname.split("/dashboard")[0] + "/dashboard";
  var LEGACY_STORAGE_KEY = "healthmes.workspace.web.v1";
  var STORAGE_KEY = LEGACY_STORAGE_KEY + ".instance."
    + stableHash(window.location.origin + dashboardRoot);
  var MIGRATION_KEY = STORAGE_KEY + ".legacy-migration-complete";

  function stableHash(value) {
    var hash = 2166136261;
    String(value).split("").forEach(function (character) {
      hash ^= character.charCodeAt(0);
      hash = Math.imul(hash, 16777619);
    });
    return (hash >>> 0).toString(36);
  }

  function createId(prefix) {
    if (window.crypto && typeof window.crypto.randomUUID === "function") {
      return prefix + "-" + window.crypto.randomUUID();
    }
    return prefix + "-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 9);
  }

  function cleanText(value, limit) {
    return String(value || "").replace(/\s+/g, " ").trim().slice(0, limit);
  }

  function defaultState() {
    return {
      version: SCHEMA_VERSION,
      selectedChannel: channelFromLocation(),
      systemOrder: ["overview", "calendar", "insights", "decisions", "agent"],
      hiddenSystem: [],
      favorites: [],
      categories: [],
      drafts: {},
      posts: {},
      threadDrafts: {},
      threads: {}
    };
  }

  function normalizeStringList(value, allowed) {
    var seen = {};
    var result = [];
    if (!Array.isArray(value)) { return result; }
    value.forEach(function (item) {
      if (typeof item !== "string" || seen[item] || (allowed && !allowed[item])) { return; }
      seen[item] = true;
      result.push(item);
    });
    return result;
  }

  function normalizeMessages(value) {
    if (!Array.isArray(value)) { return []; }
    return value.map(function (message) {
      if (!message || typeof message !== "object") { return null; }
      var body = String(message.body || "").trim().slice(0, 4000);
      if (!body) { return null; }
      return {
        id: typeof message.id === "string" ? message.id : createId("message"),
        body: body,
        createdAt: typeof message.createdAt === "string"
          ? message.createdAt
          : new Date().toISOString()
      };
    }).filter(Boolean);
  }

  function normalizeState(value) {
    var base = defaultState();
    if (!value || typeof value !== "object") {
      return base;
    }

    var systemAllowed = {};
    Object.keys(SYSTEM_CHANNELS).forEach(function (id) { systemAllowed[id] = true; });
    var order = normalizeStringList(value.systemOrder, systemAllowed);
    Object.keys(SYSTEM_CHANNELS).forEach(function (id) {
      if (order.indexOf(id) === -1) { order.push(id); }
    });

    var categoryIds = {};
    var channelIds = {};
    var categories = Array.isArray(value.categories) ? value.categories : [];
    categories = categories.map(function (category) {
      if (!category || typeof category !== "object") { return null; }
      var categoryId = typeof category.id === "string" ? category.id : createId("category");
      if (categoryIds[categoryId]) { return null; }
      categoryIds[categoryId] = true;
      var title = cleanText(category.title, 48);
      if (!title) { return null; }
      var channels = Array.isArray(category.channels) ? category.channels : [];
      channels = channels.map(function (channel) {
        if (!channel || typeof channel !== "object") { return null; }
        var channelId = typeof channel.id === "string" ? channel.id : createId("channel");
        if (channelIds[channelId] || systemAllowed[channelId]) { return null; }
        channelIds[channelId] = true;
        var channelTitleValue = cleanText(channel.title, 48);
        if (!channelTitleValue) { return null; }
        return {
          id: channelId,
          title: channelTitleValue,
          canvasKind: Object.prototype.hasOwnProperty.call(CANVAS_LABELS, channel.canvasKind)
            ? channel.canvasKind
            : "mixed"
        };
      }).filter(Boolean);
      return {
        id: categoryId,
        title: title,
        collapsed: category.collapsed === true,
        channels: channels
      };
    }).filter(Boolean);

    var allChannels = {};
    Object.keys(SYSTEM_CHANNELS).forEach(function (id) { allChannels[id] = true; });
    Object.keys(channelIds).forEach(function (id) { allChannels[id] = true; });

    var drafts = {};
    if (value.drafts && typeof value.drafts === "object") {
      Object.keys(value.drafts).forEach(function (id) {
        if (allChannels[id] && typeof value.drafts[id] === "string") {
          drafts[id] = value.drafts[id].slice(0, 4000);
        }
      });
    }

    var posts = {};
    if (value.posts && typeof value.posts === "object") {
      Object.keys(value.posts).forEach(function (id) {
        if (allChannels[id]) { posts[id] = normalizeMessages(value.posts[id]); }
      });
    }

    var threads = {};
    if (value.threads && typeof value.threads === "object") {
      Object.keys(value.threads).forEach(function (id) {
        var thread = value.threads[id];
        if (!thread || typeof thread !== "object") { return; }
        threads[id] = {
          title: cleanText(thread.title, 160) || "Thread",
          kind: cleanText(thread.kind, 60) || "workspace",
          messages: normalizeMessages(thread.messages)
        };
      });
    }

    var threadDrafts = {};
    if (value.threadDrafts && typeof value.threadDrafts === "object") {
      Object.keys(value.threadDrafts).forEach(function (id) {
        if (typeof value.threadDrafts[id] === "string") {
          threadDrafts[id] = value.threadDrafts[id].slice(0, 4000);
        }
      });
    }

    var selected = typeof value.selectedChannel === "string" && allChannels[value.selectedChannel]
      ? value.selectedChannel
      : base.selectedChannel;

    return {
      version: SCHEMA_VERSION,
      selectedChannel: selected,
      systemOrder: order,
      hiddenSystem: normalizeStringList(value.hiddenSystem, systemAllowed),
      favorites: normalizeStringList(value.favorites, allChannels),
      categories: categories,
      drafts: drafts,
      posts: posts,
      threadDrafts: threadDrafts,
      threads: threads
    };
  }

  function loadState() {
    var raw;
    try {
      raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw === null && window.localStorage.getItem(MIGRATION_KEY) !== "done") {
        var candidate = window.localStorage.getItem(LEGACY_STORAGE_KEY);
        if (candidate !== null) {
          window.localStorage.setItem(STORAGE_KEY, candidate);
          raw = candidate;
        }
        window.localStorage.setItem(MIGRATION_KEY, "done");
      }
      if (raw === null) {
        return { state: defaultState(), mode: "writable" };
      }
      var decoded = JSON.parse(raw);
      if (!decoded || typeof decoded !== "object") {
        return { state: defaultState(), mode: "corrupted" };
      }
      if (typeof decoded.version !== "number") {
        return { state: defaultState(), mode: "corrupted" };
      }
      if (decoded.version > SCHEMA_VERSION) {
        return { state: defaultState(), mode: "future_schema" };
      }
      if (decoded.version !== SCHEMA_VERSION) {
        return { state: defaultState(), mode: "corrupted" };
      }
      return { state: normalizeState(decoded), mode: "writable" };
    } catch (error) {
      return { state: defaultState(), mode: "corrupted" };
    }
  }

  var loaded = loadState();
  var state = loaded.state;
  storageMode = loaded.mode;
  var persistedSnapshot = JSON.stringify(state);

  function showStorageStatus(message, allowReset) {
    if (!storageStatus) { return; }
    storageStatus.hidden = false;
    storageStatus.textContent = message;
    if (allowReset) {
      var reset = createButton(
        "로컬 데이터 초기화",
        "storage-reset",
        "reset-local-workspace"
      );
      storageStatus.appendChild(document.createTextNode(" "));
      storageStatus.appendChild(reset);
    }
  }

  function storageModeMessage() {
    if (storageMode === "future_schema") {
      return "이 브라우저의 워크스페이스는 더 최신 버전입니다. 현재 버전에서는 표시하거나 편집하지 않고 원본을 그대로 보존합니다.";
    }
    if (storageMode === "corrupted") {
      return "로컬 워크스페이스를 읽을 수 없습니다. 원본 보호를 위해 편집을 중지했습니다.";
    }
    return "";
  }

  function ensureWritable() {
    if (storageMode === "writable") { return true; }
    showStorageStatus(storageModeMessage(), true);
    return false;
  }

  function saveState() {
    if (!ensureWritable()) { return false; }
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      persistedSnapshot = JSON.stringify(state);
      shell.setAttribute("data-local-storage", "available");
      if (storageStatus) {
        storageStatus.hidden = true;
        storageStatus.textContent = "";
      }
      return true;
    } catch (error) {
      state = normalizeState(JSON.parse(persistedSnapshot));
      shell.setAttribute("data-local-storage", "unavailable");
      showStorageStatus(
        "로컬 저장에 실패해 변경을 취소했습니다. 작성 중인 입력은 화면에 남아 있습니다.",
        false
      );
      return false;
    }
  }

  function snapshotState() {
    return JSON.stringify(state);
  }

  function restoreSnapshot(snapshot) {
    state = normalizeState(JSON.parse(snapshot));
  }

  function channelFromLocation() {
    var hash = window.location.hash;
    if (hash.indexOf("#channel-") === 0) {
      try {
        return decodeURIComponent(hash.slice("#channel-".length));
      } catch (error) {
        return hash.slice("#channel-".length);
      }
    }
    var path = window.location.pathname.replace(/\/+$/, "");
    if (path.endsWith("/decisions")) { return "decisions"; }
    if (path.endsWith("/history")) { return "insights"; }
    if (path.endsWith("/plan")) { return "calendar"; }
    return "overview";
  }

  function findUserChannel(channelId) {
    var found = null;
    state.categories.some(function (category) {
      return category.channels.some(function (channel) {
        if (channel.id !== channelId) { return false; }
        found = { category: category, channel: channel };
        return true;
      });
    });
    return found;
  }

  function channelMeta(channelId) {
    if (SYSTEM_CHANNELS[channelId]) { return SYSTEM_CHANNELS[channelId]; }
    var found = findUserChannel(channelId);
    if (!found) { return SYSTEM_CHANNELS.overview; }
    return {
      title: found.channel.title,
      description: CANVAS_LABELS[found.channel.canvasKind] + " · 이 브라우저에만 저장"
    };
  }

  function createButton(label, className, action, title) {
    var button = document.createElement("button");
    button.type = "button";
    button.className = className;
    button.textContent = label;
    button.setAttribute("data-action", action);
    if (title) {
      button.title = title;
      button.setAttribute("aria-label", title);
    }
    return button;
  }

  function createChannelRow(channel, options) {
    var wrapper = document.createElement("li");
    wrapper.className = "channel-row-wrap";
    wrapper.draggable = true;
    wrapper.setAttribute("data-channel-wrapper", channel.id);
    wrapper.setAttribute("data-channel-scope", options.system ? "system" : "user");
    if (!options.system) {
      wrapper.setAttribute("data-category-id", options.categoryId);
    }

    var button = document.createElement("button");
    button.type = "button";
    button.className = "channel-row";
    button.setAttribute("data-channel-id", channel.id);
    if (options.href) {
      button.setAttribute("data-fallback-href", options.href);
    }
    if (state.selectedChannel === channel.id) {
      button.setAttribute("aria-current", "page");
    }

    var glyph = document.createElement("span");
    glyph.className = "channel-glyph";
    glyph.textContent = options.glyph || "#";
    var label = document.createElement("span");
    label.className = "channel-label";
    label.textContent = channel.title;
    button.appendChild(glyph);
    button.appendChild(label);

    var threadCount = Object.keys(state.threads).filter(function (threadId) {
      return threadId.indexOf("channel:" + channel.id + ":") === 0
        && state.threads[threadId].messages.length > 0;
    }).length;
    if (threadCount) {
      var count = document.createElement("span");
      count.className = "channel-count";
      count.textContent = String(threadCount);
      button.appendChild(count);
    }

    wrapper.appendChild(button);
    var favorite = createButton(
      state.favorites.indexOf(channel.id) >= 0 ? "★" : "☆",
      "channel-action",
      "toggle-favorite",
      state.favorites.indexOf(channel.id) >= 0 ? "즐겨찾기 해제" : "즐겨찾기"
    );
    favorite.setAttribute("data-channel-id", channel.id);
    favorite.setAttribute(
      "data-active",
      String(state.favorites.indexOf(channel.id) >= 0)
    );
    wrapper.appendChild(favorite);

    if (options.reorderable !== false) {
      var moves = document.createElement("span");
      moves.className = "channel-move-actions";
      var up = createButton("↑", "channel-action", "move-channel-up", "위로 이동");
      var down = createButton("↓", "channel-action", "move-channel-down", "아래로 이동");
      [up, down].forEach(function (move) {
        move.setAttribute("data-channel-id", channel.id);
        move.setAttribute("data-channel-scope", options.system ? "system" : "user");
        if (!options.system) {
          move.setAttribute("data-category-id", options.categoryId);
        }
        moves.appendChild(move);
      });
      wrapper.appendChild(moves);
    }

    var secondary = createButton(
      options.system ? "×" : "…",
      "channel-action",
      options.system ? "hide-system-channel" : "edit-channel",
      options.system ? "기본 채널 숨기기" : "채널 이름 변경 또는 삭제"
    );
    secondary.setAttribute("data-channel-id", channel.id);
    if (!options.system) {
      secondary.setAttribute("data-category-id", options.categoryId);
    }
    wrapper.appendChild(secondary);
    if (!options.system && state.categories.length > 1) {
      var transfer = document.createElement("select");
      transfer.className = "channel-transfer";
      transfer.setAttribute("data-transfer-channel", channel.id);
      transfer.setAttribute("data-category-id", options.categoryId);
      transfer.setAttribute("aria-label", channel.title + " 채널을 다른 카테고리로 이동");
      var current = document.createElement("option");
      current.value = "";
      current.textContent = "이동…";
      transfer.appendChild(current);
      state.categories.forEach(function (category) {
        if (category.id === options.categoryId) { return; }
        var option = document.createElement("option");
        option.value = category.id;
        option.textContent = category.title;
        transfer.appendChild(option);
      });
      wrapper.appendChild(transfer);
    }
    return wrapper;
  }

  function renderSystemChannels() {
    systemList.textContent = "";
    state.systemOrder.forEach(function (id) {
      if (!SYSTEM_CHANNELS[id] || state.hiddenSystem.indexOf(id) >= 0) { return; }
      systemList.appendChild(createChannelRow(
        { id: id, title: SYSTEM_CHANNELS[id].title },
        {
          system: true,
          glyph: id.charAt(0).toUpperCase(),
          href: "#channel-" + id
        }
      ));
    });
    var restore = shell.querySelector("[data-restore-system]");
    restore.hidden = state.hiddenSystem.length === 0;
  }

  function renderFavorites() {
    favoritesList.textContent = "";
    state.favorites.forEach(function (id) {
      if (state.hiddenSystem.indexOf(id) >= 0) { return; }
      var meta = channelMeta(id);
      if (!meta) { return; }
      var row = createChannelRow(
        { id: id, title: meta.title },
        { system: Boolean(SYSTEM_CHANNELS[id]), glyph: "★" }
      );
      row.draggable = false;
      var actions = row.querySelectorAll(".channel-action");
      Array.prototype.forEach.call(actions, function (action) { action.remove(); });
      favoritesList.appendChild(row);
    });
    favoritesSection.hidden = favoritesList.children.length === 0;
  }

  function renderCategories() {
    localCategoriesMount.textContent = "";
    state.categories.forEach(function (category) {
      var section = document.createElement("section");
      section.className = "workspace-category";
      section.draggable = true;
      section.setAttribute("data-category-id", category.id);
      section.setAttribute("data-collapsed", String(category.collapsed));

      var heading = document.createElement("div");
      heading.className = "category-heading";
      var toggle = createButton("▾", "category-toggle", "toggle-category", "카테고리 접기/펼치기");
      toggle.setAttribute("data-category-id", category.id);
      toggle.setAttribute("aria-expanded", String(!category.collapsed));
      var title = document.createElement("strong");
      title.textContent = category.title;
      var menu = document.createElement("div");
      menu.className = "category-menu";
      var add = createButton("+", "channel-create", "open-channel-dialog", "채널 추가");
      add.setAttribute("data-category-id", category.id);
      var edit = createButton("…", "", "edit-category", "카테고리 이름 변경 또는 삭제");
      edit.setAttribute("data-category-id", category.id);
      menu.appendChild(add);
      menu.appendChild(edit);
      var moveUp = createButton("↑", "", "move-category-up", "카테고리 위로 이동");
      var moveDown = createButton("↓", "", "move-category-down", "카테고리 아래로 이동");
      moveUp.setAttribute("data-category-id", category.id);
      moveDown.setAttribute("data-category-id", category.id);
      menu.appendChild(moveUp);
      menu.appendChild(moveDown);
      heading.appendChild(toggle);
      heading.appendChild(title);
      heading.appendChild(menu);

      var list = document.createElement("ul");
      list.className = "channel-list";
      category.channels.forEach(function (channel) {
        list.appendChild(createChannelRow(channel, {
          system: false,
          categoryId: category.id,
          glyph: "#"
        }));
      });
      if (!category.channels.length) {
        var empty = document.createElement("li");
        empty.className = "empty-state";
        empty.textContent = "채널 없음";
        list.appendChild(empty);
      }

      section.appendChild(heading);
      section.appendChild(list);
      localCategoriesMount.appendChild(section);
    });
    populateCategorySelect();
  }

  function renderLocalPosts(channelId, feed) {
    feed.textContent = "";
    var posts = state.posts[channelId] || [];
    if (!posts.length) {
      var empty = document.createElement("li");
      empty.className = "empty-state";
      empty.textContent = "이 브라우저에 저장된 글이 없습니다.";
      feed.appendChild(empty);
      return;
    }
    posts.forEach(function (post) {
      var item = document.createElement("li");
      item.className = "local-post";
      var head = document.createElement("div");
      head.className = "local-post-head";
      var author = document.createElement("strong");
      author.textContent = "나";
      var time = document.createElement("time");
      time.dateTime = post.createdAt;
      time.textContent = new Date(post.createdAt).toLocaleString();
      var thread = createButton("스레드", "thread-trigger", "open-local-thread", "이 글의 스레드 열기");
      var anchorId = "channel:" + channelId + ":post:" + post.id;
      thread.setAttribute("data-thread-anchor", anchorId);
      thread.setAttribute("data-thread-title", post.body.slice(0, 120));
      thread.setAttribute("data-thread-kind", "local post");
      head.appendChild(author);
      head.appendChild(time);
      head.appendChild(thread);
      var body = document.createElement("p");
      body.textContent = post.body;
      item.appendChild(head);
      item.appendChild(body);
      feed.appendChild(item);
    });
  }

  function createLocalComposer(channelId) {
    var composer = document.createElement("div");
    composer.className = "local-composer";
    composer.setAttribute("data-local-composer", channelId);
    var textarea = document.createElement("textarea");
    textarea.setAttribute("data-local-draft", channelId);
    textarea.maxLength = 4000;
    textarea.placeholder = "로컬 메모나 작업 맥락을 남기세요";
    textarea.value = state.drafts[channelId] || "";
    var send = createButton("로컬에 저장", "", "submit-local-post");
    send.setAttribute("data-channel-id", channelId);
    var note = document.createElement("p");
    note.className = "composer-note";
    note.textContent = "서버나 HealthMes Agent로 전송하지 않습니다. 이 브라우저에만 저장됩니다.";
    composer.appendChild(textarea);
    composer.appendChild(send);
    composer.appendChild(note);
    return composer;
  }

  function renderCustomPanels() {
    customPanelsMount.textContent = "";
    state.categories.forEach(function (category) {
      category.channels.forEach(function (channel) {
        var panel = document.createElement("section");
        panel.className = "channel-panel";
        panel.id = "channel-panel-" + channel.id;
        panel.setAttribute("data-channel-panel", channel.id);
        panel.setAttribute("data-active", String(state.selectedChannel === channel.id));
        panel.setAttribute("aria-hidden", String(state.selectedChannel !== channel.id));

        var sourceKind = {
          dashboard: "overview",
          calendar: "calendar",
          visualization: "insights",
          decision: "decisions",
          conversation: "agent",
          mixed: "overview"
        }[channel.canvasKind] || "overview";
        if (sourceKind === "agent") {
          var localCanvas = document.createElement("article");
          localCanvas.className = "primitive agent-canvas";
          var localFeed = document.createElement("ul");
          localFeed.className = "local-feed";
          localFeed.setAttribute("data-local-feed", channel.id);
          renderLocalPosts(channel.id, localFeed);
          localCanvas.appendChild(localFeed);
          localCanvas.appendChild(createLocalComposer(channel.id));
          panel.appendChild(localCanvas);
          customPanelsMount.appendChild(panel);
          return;
        }
        var source = shell.querySelector('[data-channel-panel="' + sourceKind + '"]');
        if (source) {
          Array.prototype.forEach.call(source.children, function (child) {
            var clone = child.cloneNode(true);
            rewriteCloneIdentifiers(clone, "clone-" + stableHash(channel.id) + "-");
            panel.appendChild(clone);
          });
        } else {
          var empty = document.createElement("p");
          empty.className = "empty-state";
          empty.textContent = "현재 연결에서 표시할 실제 HealthMes 데이터가 없습니다.";
          panel.appendChild(empty);
        }
        customPanelsMount.appendChild(panel);
      });
    });
  }

  function rewriteCloneIdentifiers(root, prefix) {
    var idMap = {};
    var nodes = [];
    if (root.id) { nodes.push(root); }
    Array.prototype.push.apply(nodes, root.querySelectorAll("[id]"));
    nodes.forEach(function (node) {
      var previous = node.id;
      var next = prefix + previous;
      idMap[previous] = next;
      node.id = next;
    });
    ["for", "aria-controls", "aria-describedby", "aria-labelledby", "aria-owns"].forEach(
      function (attribute) {
        var candidates = [];
        if (root.hasAttribute && root.hasAttribute(attribute)) { candidates.push(root); }
        Array.prototype.push.apply(
          candidates,
          root.querySelectorAll("[" + attribute + "]")
        );
        candidates.forEach(function (node) {
          var rewritten = node.getAttribute(attribute).split(/\s+/).map(function (id) {
            return idMap[id] || id;
          }).join(" ");
          node.setAttribute(attribute, rewritten);
        });
      }
    );
  }

  function renderAgentFeed() {
    var feed = shell.querySelector('[data-local-feed="agent"]');
    if (!feed) { return; }
    renderLocalPosts("agent", feed);
    var draft = shell.querySelector('[data-local-draft="agent"]');
    if (draft) { draft.value = state.drafts.agent || ""; }
  }

  function renderAll() {
    renderSystemChannels();
    renderFavorites();
    renderCategories();
    renderCustomPanels();
    renderAgentFeed();
    selectChannel(state.selectedChannel, false);
    if (storageMode !== "writable") {
      showStorageStatus(storageModeMessage(), true);
    }
  }

  function selectChannel(channelId, updateLocation) {
    var meta = channelMeta(channelId);
    var panel = shell.querySelector('[data-channel-panel="' + CSS.escape(channelId) + '"]');
    if (!panel) {
      channelId = "overview";
      meta = SYSTEM_CHANNELS.overview;
      panel = shell.querySelector('[data-channel-panel="overview"]');
    }
    state.selectedChannel = channelId;
    if (storageMode === "writable" && !saveState()) {
      channelId = state.selectedChannel;
      meta = channelMeta(channelId);
    }
    Array.prototype.forEach.call(
      shell.querySelectorAll(".channel-row[data-channel-id]"),
      function (button) {
      if (button.getAttribute("data-channel-id") === channelId) {
        button.setAttribute("aria-current", "page");
      } else {
        button.removeAttribute("aria-current");
      }
      }
    );
    Array.prototype.forEach.call(shell.querySelectorAll("[data-channel-panel]"), function (item) {
      var active = item.getAttribute("data-channel-panel") === channelId;
      item.setAttribute("data-active", String(active));
      item.setAttribute("aria-hidden", String(!active));
      if ("inert" in item) { item.inert = !active; }
    });
    channelTitle.textContent = "# " + meta.title;
    channelDescription.textContent = meta.description;
    shell.setAttribute("data-enhanced", "true");
    setSidebarOpen(false, false);
    if (updateLocation && window.history && window.history.pushState) {
      var next = window.location.pathname + window.location.search
        + "#channel-" + encodeURIComponent(channelId);
      window.history.pushState({ channel: channelId }, "", next);
    }
  }

  function toggleFavorite(channelId) {
    if (!ensureWritable()) { return; }
    var previous = snapshotState();
    var index = state.favorites.indexOf(channelId);
    if (index >= 0) {
      state.favorites.splice(index, 1);
    } else {
      state.favorites.push(channelId);
    }
    if (!saveState()) { restoreSnapshot(previous); }
    renderAll();
  }

  function hideSystemChannel(channelId) {
    if (!ensureWritable()) { return; }
    if (!SYSTEM_CHANNELS[channelId]) { return; }
    var previous = snapshotState();
    if (state.hiddenSystem.indexOf(channelId) === -1) {
      state.hiddenSystem.push(channelId);
    }
    if (state.selectedChannel === channelId) { state.selectedChannel = "overview"; }
    if (!saveState()) { restoreSnapshot(previous); }
    renderAll();
  }

  function restoreSystemChannels() {
    if (!ensureWritable()) { return; }
    var previous = snapshotState();
    state.hiddenSystem = [];
    if (!saveState()) { restoreSnapshot(previous); }
    renderAll();
  }

  function populateCategorySelect() {
    if (!channelCategorySelect) { return; }
    var selected = channelCategorySelect.value;
    channelCategorySelect.textContent = "";
    state.categories.forEach(function (category) {
      var option = document.createElement("option");
      option.value = category.id;
      option.textContent = category.title;
      channelCategorySelect.appendChild(option);
    });
    if (selected) { channelCategorySelect.value = selected; }
  }

  function showDialog(dialog) {
    if (!dialog) { return; }
    if (typeof dialog.showModal === "function") {
      dialog.showModal();
    } else {
      dialog.setAttribute("open", "");
    }
  }

  function closeDialog(dialog) {
    if (!dialog) { return; }
    if (typeof dialog.close === "function") {
      dialog.close();
    } else {
      dialog.removeAttribute("open");
    }
  }

  function addCategory() {
    if (!ensureWritable()) { return; }
    var title = cleanText(categoryInput.value, 48);
    if (!title) {
      categoryInput.focus();
      return;
    }
    if (state.categories.length >= MAX_CATEGORIES) {
      categoryInput.setCustomValidity("카테고리는 최대 " + MAX_CATEGORIES + "개까지 만들 수 있습니다.");
      categoryInput.reportValidity();
      return;
    }
    categoryInput.setCustomValidity("");
    var previous = snapshotState();
    state.categories.push({
      id: createId("category"),
      title: title,
      collapsed: false,
      channels: []
    });
    if (!saveState()) {
      restoreSnapshot(previous);
      categoryInput.focus();
      return;
    }
    categoryInput.value = "";
    closeDialog(categoryDialog);
    renderAll();
  }

  function addChannel() {
    if (!ensureWritable()) { return; }
    var title = cleanText(channelInput.value, 48);
    var category = state.categories.find(function (item) {
      return item.id === channelCategorySelect.value;
    });
    if (!title || !category) {
      channelInput.focus();
      return;
    }
    if (category.channels.length >= MAX_CHANNELS_PER_CATEGORY) {
      channelInput.setCustomValidity(
        "한 카테고리에는 최대 " + MAX_CHANNELS_PER_CATEGORY + "개 채널을 만들 수 있습니다."
      );
      channelInput.reportValidity();
      return;
    }
    channelInput.setCustomValidity("");
    var previous = snapshotState();
    var channel = {
      id: createId("channel"),
      title: title,
      canvasKind: Object.prototype.hasOwnProperty.call(CANVAS_LABELS, channelKindSelect.value)
        ? channelKindSelect.value
        : "mixed"
    };
    category.channels.push(channel);
    category.collapsed = false;
    channelInput.value = "";
    state.selectedChannel = channel.id;
    if (!saveState()) {
      restoreSnapshot(previous);
      channelInput.focus();
      return;
    }
    closeDialog(channelDialog);
    renderAll();
  }

  function editCategory(categoryId) {
    if (!ensureWritable()) { return; }
    var category = state.categories.find(function (item) { return item.id === categoryId; });
    if (!category) { return; }
    var next = window.prompt("카테고리 이름", category.title);
    if (next === null) { return; }
    var previous = snapshotState();
    next = cleanText(next, 48);
    if (!next) {
      if (!window.confirm("이 카테고리와 안의 로컬 채널을 삭제할까요?")) { return; }
      var removedIds = category.channels.map(function (channel) { return channel.id; });
      state.categories = state.categories.filter(function (item) { return item.id !== categoryId; });
      removedIds.forEach(removeChannelState);
      if (removedIds.indexOf(state.selectedChannel) >= 0) { state.selectedChannel = "overview"; }
    } else {
      category.title = next;
    }
    if (!saveState()) { restoreSnapshot(previous); }
    renderAll();
  }

  function removeChannelState(channelId) {
    delete state.drafts[channelId];
    delete state.posts[channelId];
    state.favorites = state.favorites.filter(function (id) { return id !== channelId; });
    Object.keys(state.threads).forEach(function (threadId) {
      if (threadId.indexOf("channel:" + channelId + ":") === 0) {
        delete state.threads[threadId];
        delete state.threadDrafts[threadId];
      }
    });
  }

  function editChannel(categoryId, channelId) {
    if (!ensureWritable()) { return; }
    var category = state.categories.find(function (item) { return item.id === categoryId; });
    if (!category) { return; }
    var channel = category.channels.find(function (item) { return item.id === channelId; });
    if (!channel) { return; }
    var next = window.prompt("채널 이름", channel.title);
    if (next === null) { return; }
    var previous = snapshotState();
    next = cleanText(next, 48);
    if (!next) {
      if (!window.confirm("이 로컬 채널과 글·스레드를 삭제할까요?")) { return; }
      category.channels = category.channels.filter(function (item) { return item.id !== channelId; });
      removeChannelState(channelId);
      if (state.selectedChannel === channelId) { state.selectedChannel = "overview"; }
    } else {
      channel.title = next;
    }
    if (!saveState()) { restoreSnapshot(previous); }
    renderAll();
  }

  function submitLocalPost(channelId) {
    if (!ensureWritable()) { return; }
    var draft = shell.querySelector('[data-local-draft="' + CSS.escape(channelId) + '"]');
    if (!draft) { return; }
    var body = String(draft.value || "").trim().slice(0, 4000);
    if (!body) { draft.focus(); return; }
    var previous = snapshotState();
    if (!state.posts[channelId]) { state.posts[channelId] = []; }
    if (state.posts[channelId].length >= MAX_MESSAGES_PER_FEED) {
      showStorageStatus(
        "이 채널은 로컬 글 " + MAX_MESSAGES_PER_FEED
          + "개 한도에 도달했습니다. 기존 글은 삭제되지 않았습니다.",
        false
      );
      draft.focus();
      return;
    }
    state.posts[channelId].push({
      id: createId("post"),
      body: body,
      createdAt: new Date().toISOString()
    });
    state.drafts[channelId] = "";
    if (!saveState()) {
      restoreSnapshot(previous);
      state.drafts[channelId] = body;
      draft.value = body;
      draft.focus();
      return;
    }
    if (channelId === "agent") {
      renderAgentFeed();
    } else {
      renderCustomPanels();
      selectChannel(channelId, false);
    }
  }

  function openThread(anchorId, title, kind) {
    activeThreadId = String(anchorId || "");
    if (!activeThreadId) { return; }
    if (!state.threads[activeThreadId]) {
      if (!ensureWritable()) {
        activeThreadId = null;
        return;
      }
      if (Object.keys(state.threads).length >= MAX_THREADS) {
        if (storageStatus) {
          storageStatus.hidden = false;
          storageStatus.textContent = "로컬 스레드는 최대 " + MAX_THREADS + "개까지 저장할 수 있습니다.";
        }
        return;
      }
      state.threads[activeThreadId] = {
        title: cleanText(title, 160) || "Thread",
        kind: cleanText(kind, 60) || "workspace",
        messages: []
      };
      if (!saveState()) {
        activeThreadId = null;
        return;
      }
    }
    var thread = state.threads[activeThreadId];
    threadTitle.textContent = thread.title;
    threadKind.textContent = thread.kind + " · 이 브라우저에만 저장";
    threadDraft.value = state.threadDrafts[activeThreadId] || "";
    renderThreadMessages(thread);
    previousThreadFocus = document.activeElement;
    threadPanel.hidden = false;
    shell.setAttribute("data-thread-open", "true");
    if ("inert" in workspaceMain) { workspaceMain.inert = true; }
    syncSidebarAccessibility();
    window.setTimeout(function () { threadPanel.focus(); }, 0);
  }

  function renderThreadMessages(thread) {
    threadMessages.textContent = "";
    if (!thread.messages.length) {
      var empty = document.createElement("li");
      empty.className = "empty-state";
      empty.textContent = "아직 답글이 없습니다.";
      threadMessages.appendChild(empty);
      return;
    }
    thread.messages.forEach(function (message) {
      var item = document.createElement("li");
      item.className = "thread-message";
      var head = document.createElement("div");
      head.className = "thread-message-head";
      var author = document.createElement("strong");
      author.textContent = "나";
      var time = document.createElement("time");
      time.dateTime = message.createdAt;
      time.textContent = new Date(message.createdAt).toLocaleString();
      var body = document.createElement("p");
      body.textContent = message.body;
      head.appendChild(author);
      head.appendChild(time);
      item.appendChild(head);
      item.appendChild(body);
      threadMessages.appendChild(item);
    });
    threadMessages.scrollTop = threadMessages.scrollHeight;
  }

  function closeThread() {
    threadPanel.hidden = true;
    shell.setAttribute("data-thread-open", "false");
    if ("inert" in workspaceMain) { workspaceMain.inert = false; }
    syncSidebarAccessibility();
    activeThreadId = null;
    if (previousThreadFocus && document.contains(previousThreadFocus)) {
      previousThreadFocus.focus();
    }
    previousThreadFocus = null;
  }

  function submitThreadMessage() {
    if (!ensureWritable()) { return; }
    if (!activeThreadId || !state.threads[activeThreadId]) { return; }
    var body = String(threadDraft.value || "").trim().slice(0, 4000);
    if (!body) { threadDraft.focus(); return; }
    var previous = snapshotState();
    if (state.threads[activeThreadId].messages.length >= MAX_MESSAGES_PER_FEED) {
      showStorageStatus(
        "이 스레드는 답글 " + MAX_MESSAGES_PER_FEED
          + "개 한도에 도달했습니다. 기존 답글은 삭제되지 않았습니다.",
        false
      );
      threadDraft.focus();
      return;
    }
    state.threads[activeThreadId].messages.push({
      id: createId("reply"),
      body: body,
      createdAt: new Date().toISOString()
    });
    state.threadDrafts[activeThreadId] = "";
    if (!saveState()) {
      restoreSnapshot(previous);
      state.threadDrafts[activeThreadId] = body;
      threadDraft.value = body;
      threadDraft.focus();
      return;
    }
    threadDraft.value = "";
    renderThreadMessages(state.threads[activeThreadId]);
    renderFavorites();
    renderCategories();
  }

  function moveSystemChannel(sourceId, targetId) {
    var sourceIndex = state.systemOrder.indexOf(sourceId);
    var targetIndex = state.systemOrder.indexOf(targetId);
    if (sourceIndex < 0 || targetIndex < 0 || sourceIndex === targetIndex) { return; }
    state.systemOrder.splice(sourceIndex, 1);
    state.systemOrder.splice(targetIndex, 0, sourceId);
  }

  function moveCategory(sourceId, targetId) {
    var sourceIndex = state.categories.findIndex(function (item) { return item.id === sourceId; });
    var targetIndex = state.categories.findIndex(function (item) { return item.id === targetId; });
    if (sourceIndex < 0 || targetIndex < 0 || sourceIndex === targetIndex) { return; }
    var moved = state.categories.splice(sourceIndex, 1)[0];
    state.categories.splice(targetIndex, 0, moved);
  }

  function moveUserChannel(sourceId, sourceCategoryId, targetId, targetCategoryId) {
    var sourceCategory = state.categories.find(function (item) {
      return item.id === sourceCategoryId;
    });
    var targetCategory = state.categories.find(function (item) {
      return item.id === targetCategoryId;
    });
    if (!sourceCategory || !targetCategory) { return; }
    var sourceIndex = sourceCategory.channels.findIndex(function (item) {
      return item.id === sourceId;
    });
    var targetIndex = targetCategory.channels.findIndex(function (item) {
      return item.id === targetId;
    });
    if (sourceIndex < 0 || targetIndex < 0) { return; }
    var moved = sourceCategory.channels.splice(sourceIndex, 1)[0];
    if (sourceCategory === targetCategory && sourceIndex < targetIndex) {
      targetIndex -= 1;
    }
    targetCategory.channels.splice(targetIndex, 0, moved);
  }

  function moveItemByOffset(items, id, offset) {
    var sourceIndex = items.findIndex(function (item) { return item.id === id; });
    var targetIndex = Math.max(0, Math.min(items.length - 1, sourceIndex + offset));
    if (sourceIndex < 0 || sourceIndex === targetIndex) { return; }
    var moved = items.splice(sourceIndex, 1)[0];
    items.splice(targetIndex, 0, moved);
  }

  function moveChannelByOffset(channelId, categoryId, scope, offset) {
    if (scope === "system") {
      var sourceIndex = state.systemOrder.indexOf(channelId);
      var targetIndex = Math.max(
        0,
        Math.min(state.systemOrder.length - 1, sourceIndex + offset)
      );
      if (sourceIndex < 0 || sourceIndex === targetIndex) { return; }
      state.systemOrder.splice(sourceIndex, 1);
      state.systemOrder.splice(targetIndex, 0, channelId);
      return;
    }
    var category = state.categories.find(function (item) { return item.id === categoryId; });
    if (category) { moveItemByOffset(category.channels, channelId, offset); }
  }

  function moveChannelToCategory(channelId, sourceCategoryId, targetCategoryId) {
    var source = state.categories.find(function (item) {
      return item.id === sourceCategoryId;
    });
    var target = state.categories.find(function (item) {
      return item.id === targetCategoryId;
    });
    if (!source || !target || source === target) { return false; }
    var index = source.channels.findIndex(function (item) { return item.id === channelId; });
    if (index < 0 || target.channels.length >= MAX_CHANNELS_PER_CATEGORY) {
      showStorageStatus(
        "대상 카테고리가 채널 " + MAX_CHANNELS_PER_CATEGORY + "개 한도에 도달했습니다.",
        false
      );
      return false;
    }
    target.channels.push(source.channels.splice(index, 1)[0]);
    target.collapsed = false;
    return true;
  }

  function isMobileSidebar() {
    return window.matchMedia && window.matchMedia("(max-width: 760px)").matches;
  }

  function syncSidebarAccessibility() {
    var closedOnMobile = isMobileSidebar()
      && shell.getAttribute("data-sidebar-open") !== "true";
    sidebar.setAttribute("aria-hidden", String(closedOnMobile));
    if ("inert" in sidebar) {
      sidebar.inert = closedOnMobile
        || shell.getAttribute("data-thread-open") === "true";
    }
  }

  function setSidebarOpen(open, restoreFocus) {
    shell.setAttribute("data-sidebar-open", String(open));
    if (mobileToggle) {
      mobileToggle.setAttribute("aria-expanded", String(open));
    }
    syncSidebarAccessibility();
    if (!open && restoreFocus && mobileToggle) {
      mobileToggle.focus();
    }
  }

  function openAdvanced() {
    selectChannel("overview", true);
    var details = shell.querySelector("#advanced");
    if (!details) { return; }
    details.open = true;
    window.setTimeout(function () {
      details.scrollIntoView({ block: "start", behavior: "smooth" });
      var summary = details.querySelector("summary");
      if (summary) { summary.focus(); }
    }, 0);
  }

  function resetLocalWorkspace() {
    try {
      window.localStorage.removeItem(STORAGE_KEY);
      window.localStorage.setItem(MIGRATION_KEY, "done");
    } catch (error) {
      showStorageStatus("로컬 데이터를 초기화하지 못했습니다.", false);
      return;
    }
    storageMode = "writable";
    state = defaultState();
    persistedSnapshot = JSON.stringify(state);
    shell.setAttribute("data-local-storage", "available");
    if (storageStatus) {
      storageStatus.hidden = true;
      storageStatus.textContent = "";
    }
    renderAll();
  }

  shell.addEventListener("click", function (event) {
    var channelButton = event.target.closest("[data-channel-id]");
    if (channelButton && channelButton.classList.contains("channel-row")) {
      event.preventDefault();
      selectChannel(channelButton.getAttribute("data-channel-id"), true);
      return;
    }
    var action = event.target.closest("[data-action]");
    if (!action) { return; }
    var actionName = action.getAttribute("data-action");
    var channelId = action.getAttribute("data-channel-id");
    var categoryId = action.getAttribute("data-category-id");

    if (actionName === "toggle-sidebar") {
      var sidebarOpen = shell.getAttribute("data-sidebar-open") !== "true";
      setSidebarOpen(sidebarOpen, !sidebarOpen);
    } else if (actionName === "close-sidebar") {
      setSidebarOpen(false, true);
    } else if (actionName === "toggle-favorite") {
      toggleFavorite(channelId);
    } else if (actionName === "hide-system-channel") {
      hideSystemChannel(channelId);
    } else if (actionName === "restore-system-channels") {
      restoreSystemChannels();
    } else if (actionName === "open-advanced") {
      event.preventDefault();
      openAdvanced();
    } else if (actionName === "reset-local-workspace") {
      resetLocalWorkspace();
    } else if (actionName === "open-category-dialog") {
      categoryInput.value = "";
      showDialog(categoryDialog);
      window.setTimeout(function () { categoryInput.focus(); }, 0);
    } else if (actionName === "submit-category") {
      addCategory();
    } else if (actionName === "open-channel-dialog") {
      if (!state.categories.length) {
        categoryInput.value = "";
        showDialog(categoryDialog);
        return;
      }
      populateCategorySelect();
      if (categoryId) { channelCategorySelect.value = categoryId; }
      channelInput.value = "";
      showDialog(channelDialog);
      window.setTimeout(function () { channelInput.focus(); }, 0);
    } else if (actionName === "submit-channel") {
      addChannel();
    } else if (actionName === "close-dialog") {
      closeDialog(action.closest("dialog"));
    } else if (actionName === "toggle-category") {
      if (!ensureWritable()) { return; }
      var category = state.categories.find(function (item) { return item.id === categoryId; });
      if (category) {
        var categorySnapshot = snapshotState();
        category.collapsed = !category.collapsed;
        if (!saveState()) { restoreSnapshot(categorySnapshot); }
        renderCategories();
      }
    } else if (actionName === "edit-category") {
      editCategory(categoryId);
    } else if (actionName === "move-category-up" || actionName === "move-category-down") {
      if (!ensureWritable()) { return; }
      var categoryMoveSnapshot = snapshotState();
      moveItemByOffset(
        state.categories,
        categoryId,
        actionName === "move-category-up" ? -1 : 1
      );
      if (!saveState()) { restoreSnapshot(categoryMoveSnapshot); }
      renderAll();
    } else if (actionName === "edit-channel") {
      editChannel(categoryId, channelId);
    } else if (actionName === "move-channel-up" || actionName === "move-channel-down") {
      if (!ensureWritable()) { return; }
      var channelMoveSnapshot = snapshotState();
      moveChannelByOffset(
        channelId,
        categoryId,
        action.getAttribute("data-channel-scope"),
        actionName === "move-channel-up" ? -1 : 1
      );
      if (!saveState()) { restoreSnapshot(channelMoveSnapshot); }
      renderAll();
    } else if (actionName === "submit-local-post") {
      submitLocalPost(channelId);
    } else if (actionName === "open-thread" || actionName === "open-local-thread") {
      openThread(
        action.getAttribute("data-thread-anchor"),
        action.getAttribute("data-thread-title"),
        action.getAttribute("data-thread-kind")
      );
    } else if (actionName === "close-thread") {
      closeThread();
    } else if (actionName === "submit-thread") {
      submitThreadMessage();
    }
  });

  shell.addEventListener("input", function (event) {
    var draftChannel = event.target.getAttribute("data-local-draft");
    if (draftChannel) {
      if (!ensureWritable()) {
        event.target.value = state.drafts[draftChannel] || "";
        return;
      }
      var previous = snapshotState();
      state.drafts[draftChannel] = event.target.value.slice(0, 4000);
      if (!saveState()) {
        restoreSnapshot(previous);
      }
      return;
    }
    if (event.target === threadDraft && activeThreadId) {
      if (!ensureWritable()) {
        threadDraft.value = state.threadDrafts[activeThreadId] || "";
        return;
      }
      var threadDraftSnapshot = snapshotState();
      state.threadDrafts[activeThreadId] = event.target.value.slice(0, 4000);
      if (!saveState()) { restoreSnapshot(threadDraftSnapshot); }
    }
  });

  shell.addEventListener("change", function (event) {
    var channelId = event.target.getAttribute("data-transfer-channel");
    var targetCategoryId = event.target.value;
    if (!channelId || !targetCategoryId || !ensureWritable()) { return; }
    var previous = snapshotState();
    var moved = moveChannelToCategory(
      channelId,
      event.target.getAttribute("data-category-id"),
      targetCategoryId
    );
    if (!moved) {
      event.target.value = "";
      return;
    }
    if (!saveState()) {
      restoreSnapshot(previous);
      renderAll();
      return;
    }
    renderAll();
    showStorageStatus("채널을 선택한 카테고리로 이동했습니다.", false);
  });

  shell.addEventListener("keydown", function (event) {
    if ((event.metaKey || event.ctrlKey) && event.key === "Enter") {
      var localDraft = event.target.getAttribute("data-local-draft");
      if (localDraft) {
        event.preventDefault();
        submitLocalPost(localDraft);
      } else if (event.target === threadDraft) {
        event.preventDefault();
        submitThreadMessage();
      }
    }
    if (event.key === "Escape") {
      if (shell.getAttribute("data-thread-open") === "true") {
        closeThread();
      } else {
        setSidebarOpen(false, true);
      }
    }
    if (event.key === "Tab" && shell.getAttribute("data-thread-open") === "true") {
      var focusable = Array.prototype.filter.call(
        threadPanel.querySelectorAll(
          'button:not([disabled]), textarea:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'
        ),
        function (item) { return !item.hidden; }
      );
      if (!focusable.length) { return; }
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  shell.addEventListener("dragstart", function (event) {
    var channel = event.target.closest("[data-channel-wrapper]");
    var category = event.target.closest("[data-category-id]");
    if (channel) {
      dragPayload = {
        type: channel.getAttribute("data-channel-scope") === "system"
          ? "system-channel"
          : "user-channel",
        id: channel.getAttribute("data-channel-wrapper"),
        categoryId: channel.getAttribute("data-category-id")
      };
      channel.classList.add("is-dragging");
    } else if (category && category.classList.contains("workspace-category")) {
      dragPayload = {
        type: "category",
        id: category.getAttribute("data-category-id")
      };
      category.classList.add("is-dragging");
    }
    if (dragPayload && event.dataTransfer) {
      event.dataTransfer.effectAllowed = "move";
      event.dataTransfer.setData("text/plain", dragPayload.type + ":" + dragPayload.id);
    }
  });

  shell.addEventListener("dragover", function (event) {
    if (!dragPayload) { return; }
    var target = dragPayload.type === "category"
      ? event.target.closest(".workspace-category")
      : event.target.closest("[data-channel-wrapper]");
    if (!target) { return; }
    event.preventDefault();
    target.classList.add("drag-over");
  });

  shell.addEventListener("dragleave", function (event) {
    var target = event.target.closest(".drag-over");
    if (target) { target.classList.remove("drag-over"); }
  });

  shell.addEventListener("drop", function (event) {
    if (!ensureWritable()) { return; }
    if (!dragPayload) { return; }
    var target = dragPayload.type === "category"
      ? event.target.closest(".workspace-category")
      : event.target.closest("[data-channel-wrapper]");
    if (!target) { return; }
    event.preventDefault();
    var previous = snapshotState();
    if (dragPayload.type === "system-channel"
        && target.getAttribute("data-channel-scope") === "system") {
      moveSystemChannel(dragPayload.id, target.getAttribute("data-channel-wrapper"));
    } else if (dragPayload.type === "category") {
      moveCategory(dragPayload.id, target.getAttribute("data-category-id"));
    } else if (dragPayload.type === "user-channel"
        && target.getAttribute("data-channel-scope") === "user") {
      moveUserChannel(
        dragPayload.id,
        dragPayload.categoryId,
        target.getAttribute("data-channel-wrapper"),
        target.getAttribute("data-category-id")
      );
    }
    if (!saveState()) { restoreSnapshot(previous); }
    renderAll();
  });

  shell.addEventListener("dragend", function () {
    Array.prototype.forEach.call(
      shell.querySelectorAll(".is-dragging, .drag-over"),
      function (item) {
        item.classList.remove("is-dragging");
        item.classList.remove("drag-over");
      }
    );
    dragPayload = null;
  });

  function restoreChannelFromLocation() {
    var next = channelFromLocation();
    if (findUserChannel(next) || SYSTEM_CHANNELS[next]) {
      selectChannel(next, false);
    }
  }

  window.addEventListener("popstate", restoreChannelFromLocation);
  window.addEventListener("hashchange", restoreChannelFromLocation);
  window.addEventListener("resize", syncSidebarAccessibility);

  renderAll();
  syncSidebarAccessibility();
})();
